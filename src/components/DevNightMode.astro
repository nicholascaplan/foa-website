---
import nightStyles from "../styles/night-mode.css?raw";
---

<style is:inline set:html={nightStyles} data-dev-night-styles></style>
<script is:inline data-dev-night-initializer>
  (() => {
    const key = "foa-dev-night-mode";
    const root = document.documentElement;
    try {
      if (localStorage.getItem(key) === "night") root.dataset.devTheme = "night";
    } catch {
      // Day Mode is the safe default when storage is unavailable.
    }

    const syncButtons = () => {
      document.querySelectorAll("[data-dev-night-mode]").forEach((button) => {
        button.setAttribute("aria-pressed", String(root.dataset.devTheme === "night"));
      });
    };
    document.addEventListener("DOMContentLoaded", syncButtons, { once: true });
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element) || !event.target.closest("[data-dev-night-mode]")) return;
      const night = root.dataset.devTheme !== "night";
      if (night) root.dataset.devTheme = "night";
      else delete root.dataset.devTheme;
      syncButtons();
      try {
        localStorage.setItem(key, night ? "night" : "day");
      } catch {
        // Switching still works on this page without persistence.
      }
    });
  })();
</script>

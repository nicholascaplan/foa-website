---
import type { CollectionEntry } from "astro:content";
import EventRow from "./EventRow.astro";
interface Props { events: CollectionEntry<"events">[]; showBeforeArchive?: boolean; now?: number; }
const { events, showBeforeArchive = false, now = Date.now() } = Astro.props;
---
<div class="event-list">
  {events.map(({ data }) => <EventRow event={data} timed={showBeforeArchive} now={now} />)}
</div>

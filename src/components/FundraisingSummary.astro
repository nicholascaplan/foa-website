---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../lib/urls";
import { fundraisingDisplayPercent } from "../lib/fundraising-progress";

interface Props {
  appeal: CollectionEntry<"fundraising">["data"];
  detailed?: boolean;
}
const { appeal, detailed = false } = Astro.props;
const raised = appeal.sources.reduce((sum, { amount }) => sum + amount, 0);
const displayPercent = fundraisingDisplayPercent(raised, appeal.target);
const money = (value: number) => `£${value.toLocaleString("en-GB")}`;
---
<div class:list={["fundraising-card", { "fundraising-card--detail": detailed }]} data-fundraising-card>
  {detailed
    ? <h3 class="fundraising-card__title">{appeal.title}</h3>
    : <h2 id="fundraising-update-title" class="fundraising-card__title">{appeal.title}</h2>}
  <div class="fundraising-figures">
    <p class="fundraising-figure"><strong data-count-to={raised}>{money(raised)}</strong><span>raised</span></p>
    <p class="fundraising-figure fundraising-figure--goal"><strong>{money(appeal.target)}</strong><span>goal</span></p>
  </div>
  <div class="fundraising-progress__track" role="progressbar" aria-label="Fundraising progress" aria-valuemin="0" aria-valuemax={appeal.target} aria-valuenow={Math.min(raised, appeal.target)} aria-valuetext={`${money(raised)} raised of ${money(appeal.target)}`}><div class="fundraising-progress__fill" style={`--progress: ${displayPercent}%`}></div></div>
  <div class="fundraising-card__cta">
    {!detailed && <a class="button button--primary" href={withBase("/fundraising/")}><span class="cta-label"><span class="fundraising-card__cta-label">See Our Fundraising</span> <span class="cta-word">Plan<span class="cta-tail">s<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a>}
    {detailed && <a class="text-link" href={appeal.donateUrl} target="_blank" rel="noopener noreferrer">Donate via <span class="cta-tail">JustGiving<span class="external-link-icon" aria-hidden="true">↗</span></span><span class="visually-hidden"> (opens in a new tab)</span></a>}
  </div>
</div>

<script>
  import { initFundraisingProgress } from "../lib/fundraising-progress";

  initFundraisingProgress();
</script>

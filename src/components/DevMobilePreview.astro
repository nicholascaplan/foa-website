---
interface Props { mobile?: boolean; }
const { mobile = false } = Astro.props;
const sizes = [
  { label: "Small", short: "S", width: 360, icon: "small" },
  { label: "Medium", short: "M", width: 390, icon: "medium" },
  { label: "Large", short: "L", width: 430, icon: "large" },
];
---

<div class:list={["dev-tools", { "dev-tools--mobile": mobile }]}>
  {mobile ? <div class="dev-phone-menu">
    <button class="dev-tool-button" type="button" aria-label="Phone preview size" title="Phone preview size" aria-haspopup="true" aria-expanded="false" aria-controls="dev-phone-sizes" data-phone-menu-toggle>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="7" y="2.5" width="10" height="19" rx="2"></rect>
        <path d="M10.5 18.5h3"></path>
      </svg>
    </button>
    <div class="dev-phone-sizes" id="dev-phone-sizes" role="group" aria-label="Phone preview size" data-phone-menu hidden>
      {sizes.map((size) => (
        <button class="dev-phone-size" type="button" data-mobile-preview={size.width} aria-pressed="false">
          {size.label} phone ({size.width}px)
        </button>
      ))}
    </div>
  </div> : <button class="dev-tool-button" type="button" data-mobile-preview="390" aria-label="Mobile preview" title="Mobile preview">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="7" y="2.5" width="10" height="19" rx="2"></rect>
      <path d="M10.5 18.5h3"></path>
    </svg>
  </button>}
  {!mobile && <button class="dev-tool-button" type="button" data-reset-cookie-preferences aria-label="Reset cookie consent" title="Reset cookie consent">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.5 12.5A8.5 8.5 0 1 1 11.5 3a4 4 0 0 0 5 5 4 4 0 0 0 4 4.5Z"></path>
      <path d="M8 12h.01M12 16h.01M14 11h.01"></path>
    </svg>
  </button>}
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-mobile-preview]");
  const syncSize = () => {
    buttons.forEach((button) => {
      button.setAttribute("aria-pressed", String(window.name === "foa-mobile-preview" && window.innerWidth === Number(button.dataset.mobilePreview)));
    });
  };
  const resizePreview = (preview: Window, width: number, height: number) => {
    // resizeTo uses the outer window dimensions; account for browser chrome.
    preview.resizeTo(width + Math.max(0, preview.outerWidth - preview.innerWidth), height + Math.max(0, preview.outerHeight - preview.innerHeight));
    preview.focus();
  };

  const menuToggle = document.querySelector<HTMLButtonElement>("[data-phone-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-phone-menu]");
  const setMenu = (open: boolean) => {
    if (!menu || !menuToggle) return;
    menu.hidden = !open;
    menuToggle.setAttribute("aria-expanded", String(open));
  };
  menuToggle?.addEventListener("click", () => setMenu(menu?.hidden ?? false));
  document.addEventListener("click", (event) => {
    if (menu && !menu.hidden && event.target instanceof Node && !menu.contains(event.target) && !menuToggle?.contains(event.target)) setMenu(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) {
      setMenu(false);
      menuToggle?.focus();
    }
  });

  buttons.forEach((button) => button.addEventListener("click", () => {
    setMenu(false);
    const width = Number(button.dataset.mobilePreview);
    if (window.name === "foa-mobile-preview") {
      resizePreview(window, width, window.innerHeight);
    } else {
      const height = Math.min(844, window.screen.availHeight - 80);
      const left = Math.max(0, window.screen.availWidth - width - 24);
      const preview = window.open(window.location.href, "foa-mobile-preview", `popup,width=${width},height=${height},left=${left},top=40`);
      if (preview) resizePreview(preview, width, height);
    }
  }));
  window.addEventListener("resize", syncSize);
  syncSize();

  document.querySelector<HTMLButtonElement>("[data-reset-cookie-preferences]")?.addEventListener("click", () => {
    window.dispatchEvent(new Event("foa:reset-cookie-preferences"));
  });
</script>

<style>
  .dev-tools {
    display: flex;
    flex: none;
    gap: 0.4rem;
    align-items: center;
  }

  .dev-tools--mobile {
    display: none;
  }

  .dev-tool-button {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    place-items: center;
    color: var(--white);
    background: var(--green-dark);
    box-shadow: var(--shadow);
    font: inherit;
    font-size: 0;
    cursor: pointer;
  }

  .dev-tool-button:hover {
    background: var(--green);
  }

  .dev-phone-menu {
    position: relative;
  }

  .dev-phone-sizes {
    position: absolute;
    z-index: 80;
    top: calc(100% + 0.5rem);
    right: 0;
    display: grid;
    min-width: 12.5rem;
    gap: 0.25rem;
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .dev-phone-size {
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    color: var(--ink);
    background: transparent;
    font: inherit;
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
  }

  .dev-phone-size[aria-pressed="true"] {
    color: var(--action-foreground);
    background: var(--action-background);
  }

  .dev-phone-size:hover {
    border-color: var(--amber);
  }

  .dev-phone-size:focus-visible,
  .dev-tool-button:focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
  }

  .dev-tool-button svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (max-width: 47.99rem) {
    .dev-tools {
      display: none;
    }

    .dev-tools--mobile {
      display: flex;
      max-width: 100%;
    }
  }
</style>

<style is:global>
  /* Dev-only header layout: tools sit between the home link and navigation, wrapping rather than overlapping. */
  @media (min-width: 48rem) {
    .header-inner:has(> .dev-tools) {
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      padding-block: 0.5rem;
    }

    .header-inner:has(> .dev-tools) .desktop-nav {
      margin-inline-start: auto;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .header-inner:has(> .dev-tools) .header-actions:has(> .menu-toggle-slot) {
      margin-inline-start: auto;
    }
  }

  /* With the full navigation showing, let the links wrap so the theme toggle stays on the same row. */
  @media (min-width: 64rem) {
    .header-inner:has(> .dev-tools) {
      flex-wrap: nowrap;
    }

    .header-inner:has(> .dev-tools) .desktop-nav {
      min-width: 0;
      flex: 0 1 auto;
    }

    .header-inner:has(> .dev-tools) .header-actions {
      flex: none;
    }
  }
</style>

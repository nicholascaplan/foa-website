---
import DevNightModeToggle from "./DevNightModeToggle.astro";
---

<div class="dev-tools">
  <DevNightModeToggle />
  <button class="dev-tool-button" type="button" data-mobile-preview>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="7" y="2.5" width="10" height="19" rx="2"></rect>
      <path d="M10.5 18.5h3"></path>
    </svg>
    <span class="visually-hidden">Mobile preview</span>
  </button>
  <button class="dev-tool-button" type="button" data-reset-cookie-preferences aria-label="Reset cookie consent" title="Reset cookie consent">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.5 12.5A8.5 8.5 0 1 1 11.5 3a4 4 0 0 0 5 5 4 4 0 0 0 4 4.5Z"></path>
      <path d="M8 12h.01M12 16h.01M14 11h.01"></path>
    </svg>
  </button>
</div>

<script>
  document.querySelector<HTMLButtonElement>("[data-mobile-preview]")?.addEventListener("click", () => {
    const width = 390;
    const height = Math.min(844, window.screen.availHeight - 80);
    const left = Math.max(0, window.screen.availWidth - width - 24);
    window.open(window.location.href, "foa-mobile-preview", `popup,width=${width},height=${height},left=${left},top=40`);
  });

  document.querySelector<HTMLButtonElement>("[data-reset-cookie-preferences]")?.addEventListener("click", () => {
    window.dispatchEvent(new Event("foa:reset-cookie-preferences"));
  });
</script>

<style>
  .dev-tools {
    display: flex;
    flex: none;
    gap: 0.4rem;
  }

  .dev-tool-button {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    place-items: center;
    color: var(--white);
    background: var(--green-dark);
    box-shadow: var(--shadow);
    font: inherit;
    font-size: 0;
    cursor: pointer;
  }

  .dev-tool-button:hover {
    background: var(--green);
  }

  .dev-tool-button svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (max-width: 47.99rem) {
    .dev-tools {
      display: none;
    }
  }
</style>

---
import NewsletterSection from "./NewsletterSection.astro";

interface Props {
  sections: { title?: string; heading?: boolean; paragraphs?: string[]; list?: string[]; closing?: string[] }[];
}
const { sections } = Astro.props;
---
<div class="newsletter-peek" data-newsletter-peek aria-hidden="true" inert>
  {sections.map((section) => <NewsletterSection section={section} />)}
</div>

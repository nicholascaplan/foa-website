---
import { withBase } from "../lib/urls";
import ThemeToggle from "./ThemeToggle.astro";
import DevMobilePreview from "./DevMobilePreview.astro";

interface Props { logo?: string; }
const { logo = "/brand/foa-logo.jpg" } = Astro.props;

const primary = [
  { href: "/", label: "Home" },
  { href: "/whats-on/", label: "What's On" },
  { href: "/fundraising/", label: "Fundraising" },
  { href: "/get-involved/", label: "Get Involved" },
  { href: "/uniform/", label: "Uniform" },
];
const desktop = [primary[0], { href: "/newsletter/", label: "Newsletter" }, ...primary.slice(1)];
const mobileOnly = [
  { href: "/contact/", label: "Contact Us" },
];
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const isHomepage = currentPath === "/";
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

  <header class:list={["site-header", { "site-header--home": isHomepage, "site-header--dev-home": isHomepage && import.meta.env.DEV }]}>
    <div class="site-width header-inner">
      {isHomepage && <div class="home-introduction">
        <img src={withBase("/brand/foa-logo.jpg")} alt="The Friends of Ashley logo" width="160" height="160">
        <p><strong>The Friends of Ashley</strong><span>Ashley C of E Primary School PTA</span></p>
      </div>}
      {!isHomepage && <a class="brand" href={withBase("/")} aria-label="The Friends of Ashley home">
        <img class:list={["brand-logo", { "brand-logo--festive": logo !== "/brand/foa-logo.jpg", "brand-logo--fireworks": logo.includes("fireworks") }]} src={withBase(logo)} alt="" width="68" height="68">
        <span class="brand-copy"><strong>The Friends of Ashley</strong><span>Ashley C of E Primary School PTA</span></span>
      </a>}
      {import.meta.env.DEV && <DevMobilePreview />}
      <nav class="desktop-nav" aria-label="Primary navigation">
        {desktop.map((item) => <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <span class="header-theme-toggle"><ThemeToggle /></span>
        {!isHomepage && import.meta.env.DEV && <DevMobilePreview mobile />}
        {!isHomepage && <span class="menu-toggle-slot">
          <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </button>
        </span>}
      </div>
    </div>
  </header>
{!isHomepage && <div class="header-menu-sentinel" aria-hidden="true" data-header-menu-sentinel></div>}

<style>
  @media (max-width: 47.99rem) {
    .header-inner:has(.dev-tools--mobile) {
      gap: 0.25rem;
      flex-wrap: wrap;
    }

    .header-inner:has(.dev-tools--mobile) .brand-copy {
      display: none;
    }

    .header-inner:has(.dev-tools--mobile) .brand-logo {
      width: 2.75rem;
      height: 2.75rem;
    }

    .header-inner:has(.dev-tools--mobile) .header-actions {
      display: flex;
      gap: 0.25rem;
      max-width: 100%;
      flex-wrap: wrap;
    }
  }
</style>

{isHomepage && <button class="menu-toggle menu-toggle--floating" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
</button>}
{isHomepage && import.meta.env.DEV && <div class="home-preview-tools"><DevMobilePreview mobile /></div>}

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Site menu" aria-hidden="true" data-mobile-menu inert hidden>
  <div class="mobile-menu-panel">
    <div class="mobile-menu-head">
      <img class:list={["mobile-menu-logo", { "brand-logo--festive": logo !== "/brand/foa-logo.jpg", "brand-logo--fireworks": logo.includes("fireworks") }]} src={withBase(logo)} alt="" width="88" height="88">
      <div class="mobile-menu-controls">
        <span class="mobile-menu-theme"><ThemeToggle /></span>
        <button class="menu-close" type="button" aria-label="Close menu" data-menu-close>&times;</button>
      </div>
      <p class="mobile-menu-name"><strong>The Friends of Ashley</strong><span>Ashley C of E Primary School PTA</span></p>
    </div>
    <nav aria-label="Mobile navigation">
      {desktop.map((item) => <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
      {mobileOnly.map((item) => <a class="button button--primary mobile-menu-cta" href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>
  </div>
</div>

<script>
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const sentinel = document.querySelector<HTMLElement>("[data-header-menu-sentinel]");

  const setMenu = (open: boolean) => {
    if (!menu || !openButton) return;
    menu.hidden = !open;
    menu.classList.toggle("is-open", open);
    menu.setAttribute("aria-hidden", String(!open));
    menu.inert = !open;
    openButton.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("menu-open", open);
    if (open) {
      // Flush the close button's rendered state after removing hidden and inert.
      // Focus must not depend on an animation frame or a visibility transition.
      closeButton?.getBoundingClientRect();
      closeButton?.focus({ preventScroll: true });
    } else openButton.focus({ preventScroll: true });
  };

  openButton?.addEventListener("click", () => setMenu(true));
  closeButton?.addEventListener("click", () => setMenu(false));
  menu?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target === menu || target.closest("a")) setMenu(false);
  });
  document.addEventListener("keydown", (event) => {
    if (!menu?.classList.contains("is-open")) return;
    if (event.key === "Escape") {
      event.preventDefault();
      setMenu(false);
      return;
    }
    if (event.key !== "Tab") return;

    const focusable = [...menu.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
    )].filter((element) => !element.hasAttribute("hidden") && element.getClientRects().length > 0);
    if (focusable.length === 0) {
      event.preventDefault();
      closeButton?.focus();
      return;
    }
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;
    if (event.shiftKey && (active === first || !menu.contains(active))) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && (active === last || !menu.contains(active))) {
      event.preventDefault();
      first.focus();
    }
  });

  if (sentinel && openButton && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(([entry]) => {
      openButton.classList.toggle("menu-toggle--floating", !entry.isIntersecting);
    });
    observer.observe(sentinel);
  }
</script>

---
import { withBase } from "../lib/urls";

const linkColumns = [
  [
    ["/whats-on/", "What's On"],
    ["/committee/", "Committee"],
    ["/uniform/", "Uniform"],
    ["/meeting-minutes/", "Meeting Minutes"],
    ["/contact/", "Contact Us"],
    ["/privacy/", "Privacy"],
  ],
  [
    ["/get-involved/", "Get Involved"],
    ["/reps/", "Reps Hub"],
    ["/newsletter/", "Newsletter"],
    ["/about/", "About The FOA"],
  ],
];
---

<footer class="site-footer">
  <div class="site-width">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-brand-home" href={withBase("/")} aria-label="The Friends of Ashley home">
          <img src={withBase("/brand/foa-logo.jpg")} alt="" width="80" height="80">
          <h2>The Friends of Ashley</h2>
        </a>
        <p>The parent teacher association for Ashley C of E Primary School, Walton-on-Thames.</p>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        <div class="footer-link-column">
          {linkColumns[0].map(([href, label]) => <a href={withBase(href)}>{label}</a>)}
          <a href="https://www.ashleyschool.org.uk/" target="_blank" rel="noopener noreferrer" aria-label="Visit Ashley School website (opens in a new tab)">Ashley School <span class="footer-link-tail">website <span class="external-link-icon" aria-hidden="true">↗</span></span></a>
        </div>
        <div class="footer-link-column">
          {linkColumns[1].map(([href, label]) => <a href={withBase(href)}>{label}</a>)}
          <a class="footer-donation-link" href="https://www.justgiving.com/charity/Friends-of-Ashley" target="_blank" rel="noopener noreferrer" aria-label="Donate via JustGiving (opens in a new tab)"><span>Donate</span><span>via <span class="footer-link-tail">JustGiving <span class="external-link-icon" aria-hidden="true">↗</span></span></span></a>
        </div>
      </nav>
    </div>
    <div class="footer-bottom"><span>Registered Charity No. 1042944</span><span>Parent-led. Child-focused. All welcome.</span><button class="footer-preferences" type="button" data-cookie-preferences>Cookie preferences</button></div>
  </div>
</footer>

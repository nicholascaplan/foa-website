---
import { withBase } from "../lib/urls";
import SocialLinks from "./SocialLinks.astro";

const linkColumns = [
  [
    ["/whats-on/", "What's On"],
    ["/committee/", "Committee"],
    ["/uniform/", "Uniform"],
    ["/meeting-minutes/", "Meeting Minutes"],
    ["/contact/", "Contact Us"],
    ["/privacy/#cookie-settings", "Privacy & cookies"],
  ],
  [
    ["/get-involved/", "Get Involved"],
    ["/reps/", "Reps Hub"],
    ["/newsletter/", "Newsletter"],
    ["/about/", "About The FOA"],
  ],
];
---

<footer class="site-footer">
  <div class="site-width">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-brand-home" href={withBase("/")} aria-label="The Friends of Ashley home">
          <img src={withBase("/brand/foa-logo-ivory.svg")} alt="" width="112" height="112">
          <h2>The Friends of Ashley</h2>
        </a>
        <p>The parent teacher association for Ashley C of E Primary School, Walton-on-Thames.</p>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        <div class="footer-link-column">
          {linkColumns[0].map(([href, label]) => <a href={withBase(href)}>{label}</a>)}
          <a href="https://www.ashleyschool.org.uk/" target="_blank" rel="noopener noreferrer" aria-label="Visit Ashley School website (opens in a new tab)">Ashley School <span class="footer-link-tail">website <span class="external-link-icon" aria-hidden="true">↗</span></span></a>
        </div>
        <div class="footer-link-column">
          {linkColumns[1].map(([href, label]) => <a href={withBase(href)}>{label}</a>)}
          <a class="footer-donation-link" href="https://www.justgiving.com/charity/Friends-of-Ashley" target="_blank" rel="noopener noreferrer" aria-label="Donate via JustGiving (opens in a new tab)"><span>Donate</span><span>via <span class="footer-link-tail">JustGiving <span class="external-link-icon" aria-hidden="true">↗</span></span></span></a>
        </div>
      </nav>
    </div>
    <SocialLinks class="footer-follow" />
    <div class="footer-bottom"><span>Registered Charity No. 1042944</span><span>Parent-led. Child-focused. All welcome.</span><a class="designer-credit" href="https://nicholascaplan.github.io/profile/" target="_blank" rel="noopener noreferrer" aria-label="Made with love by Nick (opens in a new tab)"><span>Made with <span class="credit-heart" aria-hidden="true">♥</span> by <span class="credit-name">Nick</span></span><span class="external-link-icon" aria-hidden="true">↗</span></a></div>
  </div>
</footer>

<style>
  .footer-bottom { align-items: center; gap: 1rem; }

.footer-bottom > * {
  display: inline-flex;
  align-items: center;
  min-height: 2.75rem;
}

@container footer (max-width: 47.999em) {
  .footer-bottom { flex-direction: column; align-items: flex-start; }
}
.designer-credit {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 2.75rem;
  max-width: 100%;
  color: inherit;
  font: inherit;
  text-decoration: none;
}

.designer-credit .credit-name {
  color: inherit;
  font: inherit;
  text-decoration: underline;
  text-underline-offset: 0.1875rem;
}

.credit-heart {
  color: #dca956;
  font-size: 1em;
}

.designer-credit:hover .credit-name {
  text-decoration-thickness: 2px;
}

.designer-credit:focus-visible {
  outline: 2px solid #efba60;
  outline-offset: 3px;
}

</style>

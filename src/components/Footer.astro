---
import { withBase } from "../lib/urls";

const linkColumns = [
  [
    ["/whats-on/", "What's On"],
    ["/committee/", "Committee"],
    ["/uniform/", "Uniform"],
    ["/meeting-minutes/", "Meeting Minutes"],
    ["/contact/", "Contact Us"],
    ["/privacy/", "Privacy"],
  ],
  [
    ["/get-involved/", "Get Involved"],
    ["/reps/", "Reps Hub"],
    ["/newsletter/", "Newsletter"],
    ["/about/", "About The FOA"],
  ],
];
---

<footer class="site-footer">
  <div class="site-width">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-brand-home" href={withBase("/")} aria-label="The Friends of Ashley home">
          <img src={withBase("/brand/foa-logo-ivory.svg")} alt="" width="112" height="112">
          <h2>The Friends of Ashley</h2>
        </a>
        <p>The parent teacher association for Ashley C of E Primary School, Walton-on-Thames.</p>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        <div class="footer-link-column">
          {linkColumns[0].map(([href, label]) => <a href={withBase(href)}>{label}</a>)}
          <a href="https://www.ashleyschool.org.uk/" target="_blank" rel="noopener noreferrer" aria-label="Visit Ashley School website (opens in a new tab)">Ashley School <span class="footer-link-tail">website <span class="external-link-icon" aria-hidden="true">↗</span></span></a>
        </div>
        <div class="footer-link-column">
          {linkColumns[1].map(([href, label]) => <a href={withBase(href)}>{label}</a>)}
          <a class="footer-donation-link" href="https://www.justgiving.com/charity/Friends-of-Ashley" target="_blank" rel="noopener noreferrer" aria-label="Donate via JustGiving (opens in a new tab)"><span>Donate</span><span>via <span class="footer-link-tail">JustGiving <span class="external-link-icon" aria-hidden="true">↗</span></span></span></a>
        </div>
      </nav>
    </div>
    <div class="footer-follow" role="group" aria-label="Follow the Friends of Ashley">
      <a class="footer-follow-link" href="https://www.instagram.com/thefriendsofashley/" target="_blank" rel="noopener noreferrer" aria-label="Follow The FOA on Instagram (opens in a new tab)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.1" cy="6.9" r="1" fill="currentColor" stroke="none"></circle></svg>
        <span>Instagram</span>
      </a>
      <a class="footer-follow-link" href="https://www.facebook.com/groups/friendsofashley/" target="_blank" rel="noopener noreferrer" aria-label="Ashley School Parent Community group on Facebook (opens in a new tab)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" stroke="none" aria-hidden="true" focusable="false"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        <span>Facebook</span>
      </a>
    </div>
    <div class="footer-bottom"><span>Registered Charity No. 1042944</span><span>Parent-led. Child-focused. All welcome.</span><button class="footer-preferences" type="button" data-cookie-preferences>Cookie preferences</button></div>
  </div>
</footer>

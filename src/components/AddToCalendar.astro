---
import { withBase } from "../lib/urls";
interface Props {
  eventId: string;
  class?: string;
}
const { eventId, class: className = "button button--secondary" } = Astro.props;
const file = `${eventId}.ics`;
---
<a class={className} href={withBase(`/calendar/${file}`)} download={file}>
  <svg class="calendar-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg>
  Add to calendar
</a>

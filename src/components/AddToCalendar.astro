---
import { getEntry } from "astro:content";
import { withBase } from "../lib/urls";
import { locationWithAddress } from "../lib/ics";
import { buildGoogleCalendarUrl, buildOutlookCalendarUrl } from "../lib/calendar-links";
interface Props {
  eventId: string;
  class?: string;
}
const { eventId, class: className = "button button--secondary" } = Astro.props;
const entry = await getEntry("events", eventId);
const event = entry.data;
const url = new URL(withBase(event.path ?? "/whats-on/"), Astro.site).href;
const linkable = {
  title: event.title,
  summary: event.summary,
  location: locationWithAddress(event.location),
  start: event.start,
  end: event.end,
  allDay: event.allDay,
  url,
};
const googleUrl = buildGoogleCalendarUrl(linkable);
const outlookUrl = buildOutlookCalendarUrl(linkable);
const file = `${eventId}.ics`;
const icsHref = withBase(`/calendar/${file}`);
const isRow = className.includes("event-list-calendar");
---
{googleUrl && outlookUrl ? (
  <span class:list={["add-calendar", isRow ? "add-calendar--row" : "add-calendar--page"]}>
    <span class="add-calendar-label">Add to calendar:</span>
    <a href={googleUrl} target="_blank" rel="noopener noreferrer"><span class="cta-label"><span class="cta-tail">Google<span class="external-link-icon cta-icon" aria-hidden="true">&#8599;</span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a>
    <span class="add-calendar-sep" aria-hidden="true">&middot;</span>
    <a href={outlookUrl} target="_blank" rel="noopener noreferrer"><span class="cta-label"><span class="cta-tail">Outlook<span class="external-link-icon cta-icon" aria-hidden="true">&#8599;</span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a>
    <span class="add-calendar-sep" aria-hidden="true">&middot;</span>
    <a href={icsHref} download={file}><span class="cta-label"><span class="cta-tail">File (.ics)<svg class="calendar-icon cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg></span></span></a>
  </span>
) : (
  <a class={className} href={icsHref} download={file}>
    <span class="cta-label">Add to <span class="cta-tail">calendar<svg class="calendar-icon cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg></span></span>
  </a>
)}

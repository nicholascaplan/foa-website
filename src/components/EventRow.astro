---
import type { CollectionEntry } from "astro:content";
import EventDate from "./EventDate.astro";
import AddToCalendar from "./AddToCalendar.astro";
import { withBase } from "../lib/urls";
import { ordinalDateFormatter, formatEventTimeRange } from "../lib/dates";
import { isHidden } from "../lib/event-visibility";
import { eventVisibilityRules } from "../lib/event-lifecycle";
interface Props {
  event: CollectionEntry<"events">["data"] & { id?: string };
  past?: boolean;
  timed?: boolean;
  now?: number;
  headingLevel?: "h3" | "h4";
}
const { event, past = false, timed = true, now = Date.now(), headingLevel: Heading = "h3" } = Astro.props;
const rules = timed ? eventVisibilityRules(event, past) : {};
const date = ordinalDateFormatter({ weekday: "long", timeZone: "Europe/London" });
const ticketed = Boolean(event.path && event.ticketUrl);
// Details must never be nested inside a whole-row link.
const wholeRowLink = Boolean(event.path && !ticketed && !event.info && !past);
const Wrapper = wholeRowLink ? "a" : "article";
---
<Wrapper class="event-list-item" href={wholeRowLink ? withBase(event.path!) : undefined}
  data-yearview-event data-event-title={event.title} data-past={past ? "true" : "false"}
  data-show-before={rules.showBefore} data-show-from={rules.showFrom}
  data-expires-at={rules.expiresAt} data-expires-on={rules.expiresOn} data-show-from-day={rules.showFromDay}
  hidden={isHidden(rules, now)}>
  <EventDate date={event.start} compact />
  <div>
    <Heading>{event.path && !wholeRowLink ? <a href={withBase(event.path)}>{event.title}</a> : event.title}</Heading>
    <p><time datetime={event.start.toISOString()}>{date(event.start)}{event.allDay ? "" : `, ${formatEventTimeRange(event.start, event.end)}`}</time> · {event.location}</p>
    {!past && (ticketed ? <span class="event-list-actions"><a class="button button--amber" href={withBase(event.path!)}><span class="cta-label">{(() => { const label = event.ctaLabel ?? "View event details"; const split = label.lastIndexOf(" ") + 1; return <>{label.slice(0, split)}<span class="cta-word">{label.slice(split, -1)}<span class="cta-tail">{label.slice(-1)}<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></>; })()}</span></a>{event.id && <AddToCalendar eventId={event.id} class="event-list-calendar" />}</span> : event.ctaLabel && <span class:list={["event-list-cta", event.ctaButton && "event-list-cta--button"]}>{(() => { const label = event.ctaLabel!; const split = label.lastIndexOf(" ") + 1; return <>{label.slice(0, split)}<span class="cta-word">{label.slice(split, -1)}<span class="cta-tail">{label.slice(-1)}<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></>; })()}</span>)}
    {!past && !ticketed && !wholeRowLink && event.id && <AddToCalendar eventId={event.id} class="event-list-calendar" />}
    {!past && event.info && <details class="event-list-info"><summary>{event.info.label}</summary><p>{event.info.text}</p></details>}
  </div>
</Wrapper>

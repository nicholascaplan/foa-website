---
import logoSvg from "../../assets/brand/foa-logo.svg?raw";

const body = logoSvg.replace(/^\s*<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
// Keep the ring, hexagons, curved title and top icon; the PTA label and the two
// lower icons give way to the face (eyes in the lower hexagons, mouth beneath).
const paths = [...body.matchAll(/<path[^>]*\/>/g)].map((m) => m[0]);
const artwork = [4, 6, 7].reduce((svg, i) => svg.replace(paths[i], ""), body);

const eyes = [
  { cx: 160.5, cy: 312, flip: 1 },
  { cx: 304.5, cy: 312, flip: -1 },
];

const tears = [
  { x: 160.5, delay: "0s" },
  { x: 160.5, delay: "1.7s" },
  { x: 304.5, delay: "0.85s" },
  { x: 304.5, delay: "2.55s" },
];
---
<svg class="crying-logo" viewBox="0 0 457 506" role="img" aria-label="The Friends of Ashley logo, crying">
  <defs>
    <path id="crying-logo-tear" d="M0 -16 C 9 -3 11 3 11 7 A 11 11 0 0 1 -11 7 C -11 3 -9 -3 0 -16 Z" />
  </defs>

  <ellipse class="crying-logo__puddle" cx="228.5" cy="480" rx="76" ry="8" />
  {tears.map((tear) => (
    <ellipse
      class="crying-logo__ripple"
      cx={tear.x}
      cy="480"
      rx="24"
      ry="5"
      style={`--delay:${Number.parseFloat(tear.delay) + 2.9}s`}
    />
  ))}

  <g class="crying-logo__body">
    <g set:html={artwork} />

    {eyes.map((eye) => (
      <g>
        <circle cx={eye.cx} cy={eye.cy} r="28" fill="var(--logo-teal)" />
        <path
          d={`M ${eye.cx - 22} ${eye.cy + 17} A 28 28 0 0 0 ${eye.cx + 22} ${eye.cy + 17} Q ${eye.cx} ${eye.cy + 9} ${eye.cx - 22} ${eye.cy + 17} Z`}
          fill="#8fd3cb"
        />
        <g class="crying-logo__pupil">
          <circle cx={eye.cx - 9} cy={eye.cy - 8} r="9.5" fill="#fff" />
          <circle cx={eye.cx + 11} cy={eye.cy + 3} r="4.5" fill="#fff" />
          <circle cx={eye.cx - 2} cy={eye.cy + 12} r="2.3" fill="#fff" />
        </g>
        <path
          d={`M ${eye.cx - 30 * eye.flip} ${eye.cy - 36} L ${eye.cx + 26 * eye.flip} ${eye.cy - 50}`}
          fill="none" stroke="var(--logo-teal)" stroke-width="6.5" stroke-linecap="round"
        />
      </g>
    ))}

    <path class="crying-logo__mouth" d="M205 413 Q 218 392 232.5 402 Q 247 392 260 413" />
  </g>

  {tears.map((tear) => (
    <g class="crying-logo__tear" style={`--delay:${tear.delay}`} transform={`translate(${tear.x} 338)`}>
      <g class="crying-logo__tear-drop">
        <use href="#crying-logo-tear" fill="var(--logo-teal)" />
      </g>
    </g>
  ))}
</svg>

<style>
  .crying-logo {
    display: block;
    width: min(100%, 23rem);
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  .crying-logo__mouth {
    fill: none;
    stroke: var(--logo-teal);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .crying-logo__puddle {
    fill: var(--green-light);
  }

  @media (prefers-reduced-motion: no-preference) {
    .crying-logo__puddle {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: crying-logo-puddle-grow 30s ease-out forwards;
    }
  }

  .crying-logo__ripple {
    fill: none;
    stroke: var(--logo-teal);
    stroke-width: 2.5;
    opacity: 0;
  }

  .crying-logo__tear {
    opacity: 0.95;
  }

  .crying-logo__tear-drop {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .crying-logo__body {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: crying-logo-sob 2.2s ease-in-out 13 forwards;
    }

    .crying-logo__mouth {
      transform-box: fill-box;
      transform-origin: center;
      animation: crying-logo-wobble 1.1s ease-in-out 26 forwards;
    }

    .crying-logo__pupil {
      animation: crying-logo-glance 4s ease-in-out 7 forwards;
    }

    .crying-logo__tear-drop {
      transform: none;
      opacity: 0;
      animation: crying-logo-fall 3.4s ease-in 8 forwards;
      animation-delay: var(--delay);
    }

    .crying-logo__ripple {
      transform-box: fill-box;
      transform-origin: center;
      animation: crying-logo-ripple 3.4s ease-out 7 forwards;
      animation-delay: var(--delay);
    }
  }

  @keyframes crying-logo-sob {
    0%, 100% { transform: translateY(0) scale(1); }
    15% { transform: translateY(5px) scale(1.01, 0.985); }
    30% { transform: translateY(0) scale(1); }
    45% { transform: translateY(4px) scale(1.01, 0.99); }
    60% { transform: translateY(0) scale(1); }
  }

  @keyframes crying-logo-wobble {
    0%, 100% { transform: scale(1, 1); }
    50% { transform: scale(1.06, 0.88); }
  }

  @keyframes crying-logo-glance {
    0%, 40%, 100% { transform: translate(0, 0); }
    50%, 70% { transform: translate(-3px, -3px); }
  }

  @keyframes crying-logo-fall {
    0% { opacity: 0; transform: translateY(0) scale(0.4); }
    12% { opacity: 1; transform: translateY(8px) scale(1); }
    85% { opacity: 1; transform: translateY(122px) scale(1); }
    100% { opacity: 0; transform: translateY(134px) scale(0.8); }
  }

  @keyframes crying-logo-ripple {
    0%, 8% { opacity: 0.8; transform: scale(0.4); }
    35%, 100% { opacity: 0; transform: scale(1.6); }
  }

  @keyframes crying-logo-puddle-grow {
    from { transform: scale(0.25, 0.35); }
    to { transform: scale(2.6, 2.9); }
  }
</style>

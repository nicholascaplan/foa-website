---
const hex = (cx: number, cy: number, r: number) =>
  [-90, -30, 30, 90, 150, 210]
    .map((deg, i) => {
      const a = (deg * Math.PI) / 180;
      return `${i ? "L" : "M"}${(cx + r * Math.cos(a)).toFixed(1)} ${(cy + r * Math.sin(a)).toFixed(1)}`;
    })
    .join(" ") + " Z";

const eyes = [
  { cx: 164, cy: 302, flip: 1 },
  { cx: 296, cy: 302, flip: -1 },
];
const tears = [
  { x: 164, delay: "0s" },
  { x: 164, delay: "1.1s" },
  { x: 296, delay: "0.55s" },
  { x: 296, delay: "1.65s" },
];
---
<svg class="crying-logo" viewBox="0 0 460 640" role="img" aria-label="The Friends of Ashley logo, crying">
  <defs>
    <path id="crying-logo-arc" d="M 80.3 256.4 A 152 152 0 1 1 379.7 256.4" />
    <path id="crying-logo-tear" d="M0 -16 C 9 -3 11 3 11 7 A 11 11 0 0 1 -11 7 C -11 3 -9 -3 0 -16 Z" />
  </defs>

  <ellipse class="crying-logo__puddle" cx="230" cy="600" rx="150" ry="16" />
  <ellipse class="crying-logo__ripple" cx="155" cy="600" rx="30" ry="6" />
  <ellipse class="crying-logo__ripple crying-logo__ripple--late" cx="305" cy="600" rx="30" ry="6" />

  <g class="crying-logo__body">
    <circle cx="230" cy="230" r="215" fill="#fff" stroke="var(--logo-teal)" stroke-width="14" />
    <text class="crying-logo__title" font-size="38" letter-spacing="1" text-anchor="middle">
      <textPath href="#crying-logo-arc" startOffset="50%">Friends of Ashley</textPath>
    </text>

    <path d={hex(230, 190, 64)} class="crying-logo__hex" />

    <path d={hex(164, 302, 64)} class="crying-logo__hex" />
    <path d={hex(296, 302, 64)} class="crying-logo__hex" />

    {eyes.map((eye) => (
      <g>
        <circle cx={eye.cx} cy={eye.cy} r="29" fill="var(--logo-teal)" />
        <path
          d={`M ${eye.cx - 23} ${eye.cy + 17.6} A 29 29 0 0 0 ${eye.cx + 23} ${eye.cy + 17.6} Q ${eye.cx} ${eye.cy + 10} ${eye.cx - 23} ${eye.cy + 17.6} Z`}
          fill="#8fd3cb"
        />
        <g class="crying-logo__pupil">
          <circle cx={eye.cx - 9} cy={eye.cy - 8} r="10" fill="#fff" />
          <circle cx={eye.cx + 11} cy={eye.cy + 3} r="5" fill="#fff" />
          <circle cx={eye.cx - 2} cy={eye.cy + 12} r="2.5" fill="#fff" />
        </g>
        <path
          d={`M ${eye.cx - 22 * eye.flip} ${eye.cy - 38} L ${eye.cx + 20 * eye.flip} ${eye.cy - 48}`}
          fill="none" stroke="var(--logo-teal)" stroke-width="6" stroke-linecap="round"
        />
      </g>
    ))}

    <path class="crying-logo__mouth" d="M200 402 Q 215 382 230 392 Q 245 382 260 402" />
    <ellipse cx="112" cy="356" rx="16" ry="10" class="crying-logo__blush" />
    <ellipse cx="348" cy="356" rx="16" ry="10" class="crying-logo__blush" />
  </g>

  {tears.map((tear) => (
    <g class="crying-logo__tear" style={`--delay:${tear.delay}`} transform={`translate(${tear.x} 344)`}>
      <g class="crying-logo__tear-drop">
        <use href="#crying-logo-tear" fill="var(--logo-teal)" />
        <path d={hex(0, 6, 5)} fill="var(--logo-gold)" />
      </g>
    </g>
  ))}
</svg>

<style>
  .crying-logo {
    display: block;
    width: min(100%, 16rem);
    height: auto;
    margin: 0 auto 1.5rem;
    overflow: visible;
  }

  .crying-logo__title {
    fill: var(--logo-teal);
    font-family: var(--font-body);
    font-weight: 600;
  }

  .crying-logo__hex {
    fill: #fffaf0;
    stroke: var(--logo-gold);
    stroke-width: 6;
    stroke-linejoin: round;
  }

  .crying-logo__blush {
    fill: #f4a6a0;
    opacity: 0.55;
  }

  .crying-logo__mouth {
    fill: none;
    stroke: var(--logo-teal);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .crying-logo__puddle {
    fill: var(--green-light);
  }

  .crying-logo__ripple {
    fill: none;
    stroke: var(--logo-teal);
    stroke-width: 2.5;
    opacity: 0;
  }

  .crying-logo__tear {
    opacity: 0.95;
  }

  .crying-logo__tear-drop {
    transform: translateY(70px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .crying-logo__body {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: crying-logo-sob 2.2s ease-in-out infinite;
    }

    .crying-logo__mouth {
      transform-box: fill-box;
      transform-origin: center;
      animation: crying-logo-wobble 1.1s ease-in-out infinite;
    }

    .crying-logo__pupil {
      animation: crying-logo-glance 4s ease-in-out infinite;
    }

    .crying-logo__tear-drop {
      transform: none;
      opacity: 0;
      animation: crying-logo-fall 2.2s ease-in infinite;
      animation-delay: var(--delay);
    }

    .crying-logo__ripple {
      transform-box: fill-box;
      transform-origin: center;
      animation: crying-logo-ripple 2.2s ease-out infinite 1s;
    }

    .crying-logo__ripple--late {
      animation-delay: 1.55s;
    }
  }

  @keyframes crying-logo-sob {
    0%, 100% { transform: translateY(0) scale(1); }
    15% { transform: translateY(5px) scale(1.01, 0.985); }
    30% { transform: translateY(0) scale(1); }
    45% { transform: translateY(4px) scale(1.01, 0.99); }
    60% { transform: translateY(0) scale(1); }
  }

  @keyframes crying-logo-wobble {
    0%, 100% { transform: scale(1, 1); }
    50% { transform: scale(1.06, 0.88); }
  }

  @keyframes crying-logo-glance {
    0%, 40%, 100% { transform: translate(0, 0); }
    50%, 70% { transform: translate(-3px, -3px); }
  }

  @keyframes crying-logo-fall {
    0% { opacity: 0; transform: translateY(0) scale(0.4); }
    12% { opacity: 1; transform: translateY(8px) scale(1); }
    85% { opacity: 1; transform: translateY(250px) scale(1); }
    100% { opacity: 0; transform: translateY(262px) scale(0.8); }
  }

  @keyframes crying-logo-ripple {
    0% { opacity: 0; transform: scale(0.3); }
    20% { opacity: 0.8; }
    100% { opacity: 0; transform: scale(1.6); }
  }
</style>

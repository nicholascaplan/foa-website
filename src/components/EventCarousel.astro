---
import type { CollectionEntry } from "astro:content";
import EventDate from "./EventDate.astro";
import { withBase } from "../lib/urls";

interface Props { events: CollectionEntry<"events">[]; }
const { events } = Astro.props;
---

<section class="event-carousel" data-event-carousel aria-label="Featured events" aria-roledescription="carousel">
  <div class="event-carousel-slides" aria-live="off">
    {events.map(({ data }, index) => {
      const feature = data.homepageFeature!;
      const image = data.image ? withBase(`/${encodeURIComponent(data.image)}`) : undefined;
      return <article
        class:list={["event-feature", { "event-feature--poster": feature.layout === "poster" }]}
        data-carousel-slide
        data-show-before={data.archiveFrom}
        aria-label={`${index + 1} of ${events.length}: ${data.title}`}
        aria-roledescription="slide"
        hidden={index !== 0}
        style={feature.layout !== "poster" && image ? `--event-feature-image: url("${image}")` : undefined}
      >
        {feature.layout === "poster" ? (
          <a class="event-poster-link" href={withBase(feature.ctaPath)} aria-label={`${data.title}: ${feature.ctaLabel}`}>
            <h2 class="visually-hidden">{data.title}</h2>
            <img src={image} alt={data.imageAlt} width="863" height="1260" fetchpriority={index === 0 ? "high" : "auto"} />
          </a>
        ) : (
          <>
            <EventDate date={data.start} />
            <p class="eyebrow eyebrow--light">{feature.eyebrow}</p>
            <h2>{data.title}</h2>
            <p>{data.summary}</p>
            <ul class="event-facts">
              {feature.facts.map((fact) => <li><strong>{fact.label}</strong> {fact.detail}</li>)}
            </ul>
            <a class="button button--amber" href={withBase(feature.ctaPath)}>{feature.ctaLabel}</a>
          </>
        )}
      </article>;
    })}
    <span class="carousel-progress" data-carousel-progress-track aria-hidden="true"><span data-carousel-progress></span></span>
  </div>
  <div class="event-carousel-controls" data-carousel-controls>
    <button type="button" class="carousel-control" data-carousel-previous aria-label="Show previous event"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></button>
    <button type="button" class="carousel-control" data-carousel-pause aria-label="Pause automatic event rotation">
      <svg viewBox="0 0 24 24" data-pause-icon aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
      <svg viewBox="0 0 24 24" data-resume-icon aria-hidden="true"><path d="m9 6 9 6-9 6Z" /></svg>
    </button>
    <button type="button" class="carousel-control" data-carousel-next aria-label="Show next event"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button>
  </div>
  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-carousel-status></p>
  <p class="visually-hidden">Featured events change automatically every 5 seconds. Use the controls to pause or choose an event.</p>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-event-carousel]");

  if (carousel) {
    const allSlides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const controls = carousel.querySelector<HTMLElement>("[data-carousel-controls]");
    const progressTrack = carousel.querySelector<HTMLElement>("[data-carousel-progress-track]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-previous]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const pause = carousel.querySelector<HTMLButtonElement>("[data-carousel-pause]");
    const progress = carousel.querySelector<HTMLElement>("[data-carousel-progress]");
    const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let slides: HTMLElement[] = [];
    let currentIndex = 0;
    let userPaused = reduceMotion.matches;
    let interactionPaused = false;
    let progressAnimation: Animation | undefined;
    let rotationTimer: number | undefined;
    let currentDateKey = "";

    const ukDateKey = () => {
      const parts = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/London",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).formatToParts(new Date());
      const part = (type: Intl.DateTimeFormatPartTypes) => parts.find((item) => item.type === type)?.value ?? "";
      return `${part("year")}-${part("month")}-${part("day")}`;
    };

    const stopTimer = () => {
      if (rotationTimer !== undefined) window.clearTimeout(rotationTimer);
      rotationTimer = undefined;
      progressAnimation?.cancel();
      progressAnimation = undefined;
    };

    const startTimer = () => {
      stopTimer();
      if (!progress || slides.length < 2 || userPaused || interactionPaused || document.hidden) return;
      progressAnimation = progress.animate(
        [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
        { duration: 5000, easing: "linear" },
      );
      rotationTimer = window.setTimeout(() => showSlide(currentIndex + 1), 5000);
    };

    const showSlide = (index: number, announce = false) => {
      if (!slides.length) return;
      currentIndex = (index + slides.length) % slides.length;
      allSlides.forEach((slide) => {
        slide.hidden = slide !== slides[currentIndex] || !slides.includes(slide);
        slide.dataset.active = String(slide === slides[currentIndex]);
      });
      if (status) status.textContent = announce ? slides[currentIndex].getAttribute("aria-label") ?? "" : "";
      startTimer();
    };

    const updatePauseControl = () => {
      if (!pause) return;
      pause.setAttribute("aria-label", `${userPaused ? "Resume" : "Pause"} automatic event rotation`);
      carousel.dataset.rotationPaused = String(userPaused);
    };

    const refreshEvents = () => {
      const dateKey = ukDateKey();
      if (dateKey === currentDateKey) return;
      currentDateKey = dateKey;
      slides = allSlides.filter((slide) => !slide.dataset.showBefore || dateKey < slide.dataset.showBefore);
      slides.forEach((slide, index) => slide.setAttribute("aria-label", `${index + 1} of ${slides.length}: ${slide.querySelector("h2")?.textContent ?? "Event"}`));
      if (controls) controls.hidden = slides.length < 2;
      if (progressTrack) progressTrack.hidden = slides.length < 2;
      showSlide(0);
    };

    previous?.addEventListener("click", () => showSlide(currentIndex - 1, true));
    next?.addEventListener("click", () => showSlide(currentIndex + 1, true));
    pause?.addEventListener("click", () => {
      userPaused = !userPaused;
      updatePauseControl();
      startTimer();
    });
    carousel.addEventListener("mouseenter", () => {
      interactionPaused = true;
      progressAnimation?.pause();
    });
    carousel.addEventListener("mouseleave", () => {
      interactionPaused = false;
      startTimer();
    });
    carousel.addEventListener("focusin", () => {
      interactionPaused = true;
      progressAnimation?.pause();
    });
    carousel.addEventListener("focusout", (event) => {
      if (carousel.contains(event.relatedTarget as Node | null)) return;
      interactionPaused = false;
      startTimer();
    });
    document.addEventListener("visibilitychange", () => document.hidden ? progressAnimation?.pause() : startTimer());
    reduceMotion.addEventListener("change", (event) => {
      userPaused = event.matches;
      updatePauseControl();
      startTimer();
    });

    updatePauseControl();
    refreshEvents();
    window.setInterval(refreshEvents, 60000);
  }
</script>

---
// The sign-off content is fixed, so the links are written directly, matching
// the renderInline output shape (text-link class, ↗ marker, new-tab note).
// The logos reuse the footer social-link artwork so the services match
// wherever they appear.
---
<section class="newsletter-sign-off" aria-label="Follow The FOA">
  <p>
    <svg class="sign-off-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.1" cy="6.9" r="1" fill="currentColor" stroke="none"></circle></svg>
    <span><a class="text-link" href="https://www.instagram.com/thefriendsofashley/" target="_blank" rel="noopener noreferrer">Follow us on <span class="sign-off-last-word">Instagram<span class="external-link-icon" aria-hidden="true"> ↗</span></span><span class="visually-hidden"> (opens in a new tab)</span></a></span>
  </p>
  <p>
    <svg class="sign-off-icon" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true" focusable="false"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
    <span><a class="text-link" href="https://www.facebook.com/groups/friendsofashley/" target="_blank" rel="noopener noreferrer">Join our Facebook <span class="sign-off-last-word">group<span class="external-link-icon" aria-hidden="true"> ↗</span></span><span class="visually-hidden"> (opens in a new tab)</span></a></span>
  </p>
</section>

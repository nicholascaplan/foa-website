---
interface Props { eyebrow: string; title: string; intro: string; wideTitle?: boolean; }
const { eyebrow, title, intro, wideTitle = false } = Astro.props;
const hasAction = Astro.slots.has("action");
---
<section class:list={["view-hero", { "view-hero--wide-title": wideTitle }]}>
  <div class:list={["site-width", { "view-hero-inner": hasAction }]}>
    {hasAction
      ? <>
          <div class="view-hero-copy"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{intro}</p></div>
          <div class="view-hero-action"><slot name="action" /></div>
        </>
      : <><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{intro}</p></>}
  </div>
</section>

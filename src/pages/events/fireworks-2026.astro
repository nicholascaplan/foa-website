---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/urls";
const entry = await getEntry("events", "fireworks-2026");
if (!entry) throw new Error("Fireworks event content is missing");
const event = entry.data;
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  description: event.summary,
  startDate: event.start.toISOString(),
  endDate: event.end?.toISOString(),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: { "@type": "Place", name: event.location, address: { "@type": "PostalAddress", addressLocality: "Walton-on-Thames", addressCountry: "GB" } },
  organizer: { "@type": "Organization", name: "Friends of Ashley", url: new URL(withBase("/"), Astro.site).href },
  image: new URL(withBase("/fireworks.jpg"), Astro.site).href,
};
---
<BaseLayout title={event.title} description={event.summary} image="/fireworks.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <section class="event-hero"><div class="site-width"><a class="breadcrumb" href={withBase("/whats-on/")}><span aria-hidden="true">&larr;</span> Back to What's On</a><div class="event-hero-grid"><div><p class="eyebrow eyebrow--light">Thursday 5 November 2026</p><h1>{event.title}</h1><p class="event-hero-intro">A family evening at Ashley with two displays, a Ferris wheel, fairground games, food stalls and mulled wine.</p></div><aside class="event-summary"><dl><div><dt>When</dt><dd>16:30-18:30</dd></div><div><dt>Where</dt><dd>{event.location}</dd></div><div><dt>Tickets</dt><dd>{event.ticketPrice}</dd></div><div><dt>Lead</dt><dd>{event.lead}</dd></div></dl></aside></div></div></section>
  <section class="content-section content-section--compact"><div class="site-width event-body"><div><section class="event-block"><p class="eyebrow">Plan your evening</p><h2>Two displays, one family night out.</h2><ol class="schedule"><li><time datetime="2026-11-05T16:30">16:30</time><span><strong>Gates open</strong><small>Food, games and family activities begin.</small></span></li><li><time datetime="2026-11-05T17:00">17:00</time><span><strong>Quiet display</strong><small>The earlier display is scheduled before the main event.</small></span></li><li><time datetime="2026-11-05T18:00">18:00</time><span><strong>Main display</strong><small>The evening's main fireworks display.</small></span></li></ol></section></div><aside><div class="ticket-panel"><p class="eyebrow">Tickets</p><h2>Tickets for the whole family</h2><div class="ticket-price"><span>Age 2 and over</span><strong>£8.50</strong></div><p>Under-2s attend free.</p></div></aside></div></section>
</BaseLayout>

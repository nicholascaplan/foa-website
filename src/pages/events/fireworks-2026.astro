---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SponsorRibbon from "../../components/SponsorRibbon.astro";
import { withBase } from "../../lib/urls";
const entry = await getEntry("events", "fireworks-2026");
if (!entry) throw new Error("Fireworks event content is missing");
const event = entry.data;
const timeFormatter = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Europe/London" });
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  description: event.summary,
  startDate: event.start.toISOString(),
  endDate: event.end?.toISOString(),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: { "@type": "Place", name: event.location, address: { "@type": "PostalAddress", addressLocality: "Walton-on-Thames", addressCountry: "GB" } },
  organizer: { "@type": "Organization", name: "The Friends of Ashley", url: new URL(withBase("/"), Astro.site).href },
  image: new URL(withBase("/events/fireworks-1600.jpg"), Astro.site).href,
};
---
<BaseLayout title={event.title} description={event.summary} image="/events/fireworks-1600.jpg" preloadImage="/events/fireworks-1600.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <section class="event-hero"><div class="site-width"><a class="breadcrumb" href={withBase("/whats-on/")} data-whats-on-return-path={withBase("/whats-on/")} hidden><span aria-hidden="true">&larr;</span> Back to What's On</a><div class="event-hero-grid"><div><p class="eyebrow eyebrow--light">Thursday 5th November 2026</p><h1>{event.title}</h1><p class="event-hero-intro">A family evening at Ashley with two displays, a Ferris wheel, fairground games, food stalls and mulled wine.</p><div class="event-hero-sponsor"><SponsorRibbon /></div></div><aside class="event-summary"><dl><div><dt>When</dt><dd>16:30-18:30</dd></div><div><dt>Where</dt><dd>{event.location}</dd></div><div><dt>Tickets</dt><dd>{event.ticketPrice}</dd></div><div><dt>Lead</dt><dd>{event.lead}</dd></div></dl>{event.ticketUrl && <div class="ticket-cta"><a class="button button--amber button--large" href={event.ticketUrl} target="_blank" rel="noopener noreferrer">Buy tickets <span class="external-link-icon" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>{event.ticketNote ? <p class="ticket-tip"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"></path><path d="M10 21h4"></path><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"></path></svg><span><strong>Tip:</strong> {event.ticketNote}</span></p> : <p>Tickets are sold through our ticket provider and open in a new tab.</p>}</div>}</aside></div></div></section>
  <section class="content-section content-section--compact"><div class="site-width event-body"><div class="event-main"><section class="event-block"><p class="eyebrow">Plan your evening</p><h2>Two displays, one family night out.</h2><ol class="schedule">{event.schedule?.map((item) => <li><time datetime={item.time.toISOString()}>{timeFormatter.format(item.time)}</time><span><strong>{item.label}</strong>{item.detail && <small>{item.detail}</small>}</span></li>)}</ol></section>{event.goodToKnow && <section class="event-block"><p class="eyebrow">Good to know</p><dl class="good-to-know">{event.goodToKnow.map((item) => <div><dt>{item.label}</dt><dd>{item.text}</dd></div>)}</dl></section>}</div><figure class="poster-figure poster-figure--centered"><div class="poster-frame"><img src={withBase("/events/fireworks-poster.jpg")} alt="Poster for Fireworks on the Field: Remember, remember the 5th of November. Thursday 5th November 2026, 16:30 to 18:30, tickets £8.50 per person, under 2 years free. Quiet display at 17:00, main display at 18:00, with a fairground, food stalls and mulled wine." width="1131" height="1600" loading="lazy"></div></figure></div></section>
  <script>
    const returnLink = document.querySelector<HTMLAnchorElement>("[data-whats-on-return-path]");
    if (returnLink && document.referrer) {
      try {
        const referrer = new URL(document.referrer);
        if (referrer.origin === window.location.origin && referrer.pathname === returnLink.dataset.whatsOnReturnPath) {
          returnLink.hidden = false;
        }
      } catch {
        // Leave the link hidden when the referrer cannot be parsed.
      }
    }
  </script>
</BaseLayout>

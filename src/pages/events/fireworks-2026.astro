---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SponsorRibbon from "../../components/SponsorRibbon.astro";
import FireworksTorch from "../../components/FireworksTorch.astro";
import "../../styles/fireworks.css";
import { withBase } from "../../lib/urls";
import { ordinalDateFormatter } from "../../lib/dates";
const entry = await getEntry("events", "fireworks-2026");
if (!entry) throw new Error("Fireworks event content is missing");
const event = entry.data;
const dateFormatter = ordinalDateFormatter({ weekday: "long", year: "numeric", timeZone: "Europe/London" });
const timeFormatter = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Europe/London" });
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  description: event.summary,
  startDate: event.start.toISOString(),
  endDate: event.end?.toISOString(),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: { "@type": "Place", name: event.location, address: { "@type": "PostalAddress", addressLocality: "Walton-on-Thames", addressCountry: "GB" } },
  organizer: { "@type": "Organization", name: "The Friends of Ashley", url: new URL(withBase("/"), Astro.site).href },
  image: new URL(withBase("/events/fireworks-1600.jpg"), Astro.site).href,
};
---
<BaseLayout title={event.title} description={event.summary} image="/events/fireworks-1600.jpg" preloadImage="/events/fireworks-1600.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <div class="fw-event" data-fw-stage>
    <div class="fw-torches" aria-hidden="true"><FireworksTorch /><FireworksTorch /></div>
    <div class="fw-content">
      <section class="event-hero">
        <div class="site-width">
          <div class="event-hero-grid">
            <div class="fw-title-copy">
              <p class="fw-kicker">Remember Remember the 5th of November</p>
              <p class="eyebrow eyebrow--light fw-date">{dateFormatter(event.start)}</p>
              <h1>{event.title}</h1>
              <p class="event-hero-intro">{event.summary}</p>
            </div>
            <div class="fw-overview">
              <div class="fw-mode-bar" hidden data-fw-mode-bar><button class="fw-mode-switch" type="button" role="switch" aria-checked="false" data-fw-mode>Immersive <span class="fw-mode-switch__track" aria-hidden="true"></span></button></div>
            <aside class="event-summary">
              <dl>
                <div><dt>When</dt><dd>{timeFormatter.format(event.start)}{event.end && `–${timeFormatter.format(event.end)}`}</dd></div>
                <div><dt>Where</dt><dd>{event.location}</dd></div>
                <div><dt>Tickets</dt><dd>{event.ticketPrice}</dd></div>
                <div><dt>Lead</dt><dd>{event.lead}</dd></div>
              </dl>
              {event.ticketUrl && <div class="ticket-cta">
                <a class="button button--amber button--large" href={event.ticketUrl} target="_blank" rel="noopener noreferrer">Buy tickets <span class="external-link-icon" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
                {event.ticketNote ? <p class="ticket-tip"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"></path><path d="M10 21h4"></path><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"></path></svg><span><strong>Tip:</strong> {event.ticketNote}</span></p> : <p>Tickets are sold through our ticket provider and open in a new tab.</p>}
              </div>}
            </aside>
            </div>
            <div class="event-hero-sponsor"><SponsorRibbon /></div>
          </div>
        </div>
      </section>
      <section class="content-section content-section--compact">
        <div class="site-width event-body">
          <div class="event-main">
            <section class="event-block">
              <p class="eyebrow">Plan your evening</p>
              <h2>Two displays, one family night out.</h2>
              <ol class="schedule">{event.schedule?.map((item) => <li data-fw-burst={item.burst}><time datetime={item.time.toISOString()}>{timeFormatter.format(item.time)}</time><span><strong>{item.label}</strong>{item.detail && <small>{item.detail}</small>}</span></li>)}</ol>
            </section>
            {event.goodToKnow && <section class="event-block">
              <p class="eyebrow">Good to know</p>
              <h2>Before you come.</h2>
              <dl class="good-to-know">{event.goodToKnow.map((item) => <div><dt>{item.label}</dt><dd>{item.text}</dd></div>)}</dl>
            </section>}
          </div>
        </div>
      </section>
    </div>
    <div class="fw-sky" aria-hidden="true"><canvas data-fw-sky></canvas></div>
  </div>
  <script>
    import "../../scripts/fireworks-experience";
  </script>
</BaseLayout>

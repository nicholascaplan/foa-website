---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/urls";
---

<BaseLayout title="Meeting Minutes" description="Approved meeting minutes from The Friends of Ashley.">
  <PageHero eyebrow="The FOA's record" title="Meeting minutes" intro="Read approved minutes from The Friends of Ashley meetings. Minutes are published once they have been reviewed and agreed." />
  <section class="content-section content-section--compact content-section--desktop-snug">
    <div class="site-width">
      <div class="section-heading">
        <p class="eyebrow">Approved minutes</p>
        <h2>Annual general meetings</h2>
        <p>Minutes are published once they have been reviewed and agreed. Personal or sensitive information is removed where needed.</p>
      </div>
      <article class="info-card">
        <p class="eyebrow">16th September 2026</p>
        <h3>Annual General Meeting</h3>
        <p>Read the approved minutes from The FOA's 2026 Annual General Meeting.</p>
        <p><a class="button button--secondary" href={withBase("/documents/agm-minutes-2026-09-16.pdf")} target="_blank" rel="noopener noreferrer"><span class="cta-label">Read AGM <span class="cta-tail">minutes<span class="external-link-icon cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></span><span class="visually-hidden"> (PDF opens in a new tab)</span></span></a></p>
      </article>
    </div>
  </section>
</BaseLayout>

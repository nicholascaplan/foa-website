---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Pre-loved Uniform" description="Find the next Friends of Ashley pre-loved uniform sale, prices and contact details.">
  <PageHero eyebrow="Pre-loved uniform" title="Find or donate uniform." intro="Good uniform, passed on to another Ashley family." />
  <section class="content-section content-section--compact"><div class="site-width split-layout"><div><p class="eyebrow">Next sale</p><h2 class="editorial-heading">Friday 6th November</h2><p class="section-copy">The following sale is Friday 4th December. Sales start at 15:25 in the school playground and are subject to weather.</p><p><a class="text-link" href="mailto:foapreloveduniform@gmail.com">Email the Preloved team</a></p></div><article class="info-card"><h2>What you need to know</h2><ul class="price-list"><li><span>New-logo items and coats</span><strong class="price-tag">£3 each</strong></li><li><span>All other items</span><strong class="price-tag">£1 each</strong></li><li><span>Payment</span><strong class="price-tag">Card only</strong></li></ul><p>Need an item between sales? Use the <a class="text-link" href="https://tinyurl.com/foapreloved">online request form</a> or email the team.</p><p class="donation-note">If you have any uniform which you would like to donate, please drop it in the green bins by the School Office - no torn items please!</p></article></div></section>
</BaseLayout>

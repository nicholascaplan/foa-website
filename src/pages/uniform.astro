---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Pre-loved Uniform" description="Find the next Friends of Ashley pre-loved uniform sale, prices and contact details.">
  <PageHero eyebrow="Pre-loved uniform" title="Find or donate uniform." intro="Good uniform, passed on to another Ashley family." />
  <section class="content-section content-section--compact"><div class="site-width split-layout"><div><p class="eyebrow">Next sale</p><h2 class="editorial-heading">Friday 6 November</h2><p class="section-copy">The following sale is Friday 4 December. Sales start at 15:25 in the school playground and are subject to weather.</p><p><a class="text-link" href="mailto:foapreloveduniform@gmail.com">Email the Preloved team</a></p></div><article class="info-card"><h2>What you need to know</h2><ul><li>New-logo items and coats: £3 each</li><li>All other items: £1 each</li><li>Card payments only</li></ul><p>Need an item between sales? Use the <a class="text-link" href="https://tinyurl.com/foapreloved">online request form</a> or email the team.</p><p class="draft-callout">Donation instructions and accepted items still need final confirmation before launch.</p></article></div></section>
</BaseLayout>

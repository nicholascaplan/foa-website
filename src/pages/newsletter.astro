---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/urls";
import { ordinalDateFormatter } from "../lib/dates";
import NewsletterSection from "../components/NewsletterSection.astro";
import NewsletterPeek from "../components/NewsletterPeek.astro";
import { getCollection } from "astro:content";
const newsletters = (await getCollection("newsletters"))
  .sort((a, b) => (b.data.published?.getTime() ?? 0) - (a.data.published?.getTime() ?? 0));
const latestIssue = newsletters.find(({ data }) => data.latest);
if (!latestIssue) throw new Error("No latest newsletter is configured");
const latest = latestIssue.data;
const latestPreviewCount = 3;
const latestSections = latest.sections ?? [];
const latestPreview = latestSections.slice(0, latestPreviewCount);
const latestRest = latestSections.slice(latestPreviewCount);
const latestBodyId = "newsletter-latest-more";
const previous = newsletters.filter(({ id }) => id !== latestIssue.id);
const formatDateWithOrdinal = ordinalDateFormatter({ weekday: "long", timeZone: "UTC" });
const newsletterLogo = "/brand/foa-logo-newsletter-ivory.svg";
---
<BaseLayout title="Newsletter" description="The latest news from The Friends of Ashley and previous newsletters." image="/brand/foa-logo-newsletter-og.png" headerLogo={newsletterLogo} bodyClass="newsletter-logo-page">
  <PageHero eyebrow="The FOA updates" title="Newsletter" intro="The latest news and an archive of previous updates from The FOA." logo={newsletterLogo} />
  <section class="content-section content-section--compact"><div class="site-width newsletter-page">
    <section class="newsletter-section newsletter-board">
      <div class="section-heading"><p class="eyebrow">Latest newsletter</p><h2>{latest.title}</h2></div>
      <article class="newsletter-issue newsletter-sheet">
        <div class="newsletter-letterhead"><img src={withBase("/brand/foa-logo.svg")} alt="" width="44" height="44"><span>The Friends of Ashley</span>{latest.published && <time class="newsletter-letterhead-date" datetime={latest.published.toISOString()}>Sent on {formatDateWithOrdinal(latest.published)}</time>}</div>
        {latestPreview.map((section, index) => <NewsletterSection section={section} lead={index === 0} />)}
        {latestRest.length > 0 && <>
          <NewsletterPeek sections={latestRest} />
          <div class="newsletter-more" id={latestBodyId} hidden>
            {latestRest.map((section) => <NewsletterSection section={section} />)}
          </div>
          <div class="newsletter-expansion-actions">
            <button class="button button--primary newsletter-read-more" type="button" aria-expanded="false" aria-controls={latestBodyId}>
              <span data-label>Read the full newsletter</span> <span aria-hidden="true" data-icon>&darr;</span>
            </button>
          </div>
        </>}
      </article>
    </section>
    <section class="newsletter-section newsletter-board">
      <div class="section-heading"><p class="eyebrow">Previous newsletters</p><h2>From the archive</h2><p>Earlier updates from The FOA. Open a newsletter to read it in full.</p></div>
      {previous.map(({ id, data }) => {
        const [first, ...rest] = data.sections ?? [];
        const bodyId = `newsletter-${id}-more`;
        return <article class="newsletter-summary newsletter-sheet">
          <div class="newsletter-letterhead"><img src={withBase("/brand/foa-logo.svg")} alt="" width="44" height="44"><span>The Friends of Ashley</span>{data.published && <time class="newsletter-letterhead-date" datetime={data.published.toISOString()}>Sent on {formatDateWithOrdinal(data.published)}</time>}</div>
          <p class="newsletter-summary-label">{data.title}</p>
          {first ? <NewsletterSection section={first} lead /> : <p>{data.summary}</p>}
          {rest.length > 0 && <>
            <NewsletterPeek sections={rest} />
            <div class="newsletter-more" id={bodyId} hidden>
              {rest.map((section) => <NewsletterSection section={section} />)}
            </div>
            <div class="newsletter-expansion-actions">
              <button class="button button--primary newsletter-read-more" type="button" aria-expanded="false" aria-controls={bodyId}>
                <span data-label>Read the full newsletter</span> <span aria-hidden="true" data-icon>&darr;</span>
              </button>
            </div>
          </>}
        </article>;
      })}
    </section>
  </div></section>
</BaseLayout>

<style is:global>
  /* The circle is 380 units wide inside a 550-unit SVG. Match its size and
     position to the standard logo, with clearance beneath for the envelope. */
  .newsletter-logo-page .brand-logo--festive {
    border-radius: 0;
    object-fit: contain;
    transform-origin: top left;
    transform: translate(var(--newsletter-logo-offset-x), var(--newsletter-logo-offset-y)) scale(var(--newsletter-logo-scale));
  }

  .newsletter-logo-page .mobile-menu-logo {
    margin-bottom: calc(var(--menu-logo-size) * var(--newsletter-logo-extra-height));
  }

  @media (max-width: 63.99rem) {
    .newsletter-logo-page .page-logo-home {
      aspect-ratio: 380 / 483;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const timing: KeyframeAnimationOptions = { duration: 350, easing: "ease-in-out", fill: "forwards" };

  document.querySelectorAll<HTMLButtonElement>(".newsletter-read-more").forEach((button) => {
    const more = document.getElementById(button.getAttribute("aria-controls") || "");
    if (!more) return;
    const peek = more.previousElementSibling as HTMLElement | null;
    let animation: Animation | undefined;

    button.addEventListener("click", () => {
      const expand = button.getAttribute("aria-expanded") !== "true";
      const anchorTop = button.getBoundingClientRect().top;
      button.setAttribute("aria-expanded", String(expand));
      button.querySelector("[data-label]")!.textContent = expand ? "Show less" : "Read the full newsletter";
      button.querySelector("[data-icon]")!.innerHTML = expand ? "&uarr;" : "&darr;";

      animation?.cancel();
      if (expand) {
        if (peek) peek.hidden = true;
        more.hidden = false;
      }
      if (reducedMotion.matches) {
        more.hidden = !expand;
        if (peek) peek.hidden = expand;
        if (!expand) window.scrollBy({ top: button.getBoundingClientRect().top - anchorTop, behavior: "instant" });
        return;
      }

      more.style.overflow = "hidden";
      const full = `${more.scrollHeight}px`;
      animation = more.animate(
        expand
          ? { height: ["0px", full], opacity: [0, 1] }
          : { height: [full, "0px"], opacity: [1, 0] },
        timing,
      );
      if (!expand) {
        const current = animation;
        const keepButtonInPlace = () => {
          if (animation !== current) return;
          const drift = button.getBoundingClientRect().top - anchorTop;
          if (drift) window.scrollTo({ top: window.scrollY + drift, behavior: "instant" });
          requestAnimationFrame(keepButtonInPlace);
        };
        requestAnimationFrame(keepButtonInPlace);
      }
      animation.onfinish = () => {
        more.hidden = !expand;
        if (peek) peek.hidden = expand;
        if (!expand) window.scrollBy({ top: button.getBoundingClientRect().top - anchorTop, behavior: "instant" });
        animation?.cancel();
        animation = undefined;
      };
      animation.oncancel = () => {
        more.style.overflow = "";
      };
    });
  });
</script>

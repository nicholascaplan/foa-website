---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/urls";
import NewsletterSection from "../components/NewsletterSection.astro";
import autumnTerm from "../content/newsletters/autumn-term-2026.json";
import backToSchool from "../content/newsletters/back-to-school-2026.json";
const latest = autumnTerm;
const previous = [{ id: "back-to-school-2026", data: backToSchool }];
const dateFormat = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" });
const formatDateWithOrdinal = (value: Date | string) => {
  const date = value instanceof Date ? value : new Date(value);
  return dateFormat.formatToParts(date).map((part) => {
  if (part.type !== "day") return part.value;
  const day = Number(part.value);
  const suffix = day % 100 >= 11 && day % 100 <= 13 ? "th" : (["th", "st", "nd", "rd"][day % 10] ?? "th");
  return `${part.value}${suffix}`;
  }).join("");
};
---
<BaseLayout title="Newsletter" description="The latest news from The Friends of Ashley and previous newsletters.">
  <PageHero eyebrow="The FOA updates" title="Newsletter" intro="The latest news and an archive of previous updates from The FOA." />
  <section class="content-section content-section--compact"><div class="site-width newsletter-page">
    <section class="newsletter-section">
      <div class="section-heading"><p class="eyebrow">Latest newsletter</p><h2>{latest.title}</h2>{latest.published && <p>{formatDateWithOrdinal(latest.published)}</p>}</div>
      <article class="newsletter-issue newsletter-sheet">
        <div class="newsletter-letterhead"><img src={withBase("/FOA%20Logo.jpg")} alt="" width="44" height="44"><span>The Friends of Ashley</span></div>
        {latest.sections?.map((section, index) => <NewsletterSection section={section} lead={index === 0} />)}
      </article>
    </section>
    <section class="newsletter-section">
      <div class="section-heading"><p class="eyebrow">Previous newsletters</p><h2>From the archive</h2><p>Earlier updates from The FOA. Read more to see the full newsletter.</p></div>
      {previous.map(({ id, data }) => {
        const [first, ...rest] = data.sections ?? [];
        const bodyId = `newsletter-${id}-more`;
        return <article class="newsletter-summary newsletter-sheet">
          <div class="newsletter-letterhead"><img src={withBase("/FOA%20Logo.jpg")} alt="" width="44" height="44"><span>The Friends of Ashley</span></div>
          <p class="newsletter-summary-label">{data.title}</p>
          {data.published && <p class="newsletter-summary-date">{formatDateWithOrdinal(data.published)}</p>}
          {first ? <NewsletterSection section={first} lead /> : <p>{data.summary}</p>}
          {rest.length > 0 && <>
            <div class="newsletter-more" id={bodyId} hidden>
              {rest.map((section) => <NewsletterSection section={section} />)}
            </div>
            <button class="button button--secondary newsletter-read-more" type="button" aria-expanded="false" aria-controls={bodyId}>
              <span data-label>Read more</span> <span aria-hidden="true" data-icon>&darr;</span>
            </button>
          </>}
        </article>;
      })}
    </section>
  </div></section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".newsletter-read-more").forEach((button) => {
    const more = document.getElementById(button.getAttribute("aria-controls") || "");
    if (!more) return;
    button.addEventListener("click", () => {
      const expand = button.getAttribute("aria-expanded") !== "true";
      more.hidden = !expand;
      button.setAttribute("aria-expanded", String(expand));
      button.querySelector("[data-label]")!.textContent = expand ? "Show less" : "Read more";
      button.querySelector("[data-icon]")!.innerHTML = expand ? "&uarr;" : "&darr;";
    });
  });
</script>

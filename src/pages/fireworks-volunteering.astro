---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/urls";
import { ordinalDateFormatter } from "../lib/dates";
const entry = await getEntry("events", "fireworks-2026");
const event = entry?.data;
if (!event?.volunteerRoles) throw new Error("Fireworks volunteering content is missing");
const eventDate = ordinalDateFormatter({ timeZone: "Europe/London" })(event.start);
---
<BaseLayout title="Fireworks Volunteering" description="Sign up to help at Fireworks on the Field. Choose a slot with your year group's team on Volunteer Sign Up.">
  <PageHero eyebrow={event.title} chip={eventDate} title="To make this event awesome, we need your help!" intro="Fireworks is a real team effort, and every Ashley family can play a part. Each year group is looking after one activity, so find your child's year, choose a slot and sign up in moments." />
  <section class="content-section content-section--compact content-section--snug" aria-labelledby="volunteer-teams-title">
    <div class="site-width">
      <p class="vol-tip"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"></path><path d="M10 21h4"></path><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"></path></svg><span><strong>Tip:</strong> the sign-up buttons take you to the Volunteer Sign Up site, where you choose your slot.</span></p>
      <h2 id="volunteer-teams-title" class="visually-hidden">Volunteer activities</h2>
      <ul class="vol-grid">
        {event.volunteerRoles.map((role) => (
          <li class="vol-card">
            <div class="vol-card__head">
              <p class="vol-card__group">{role.group}</p>
              <p class="vol-card__dates"><svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>{role.dates}</p>
            </div>
            <h3>{role.name}</h3>
            <p>{role.description}</p>
            <dl class="vol-shifts">
              {role.shifts.map((shift) => <div><dt>{shift.label}</dt><dd>{shift.when}<span>{shift.helpers} {shift.helpers === 1 ? "helper" : "helpers"} {role.shifts.length > 1 && shift.label !== "Setup" && shift.label !== "Clear up" ? "per shift" : "per slot"}</span></dd></div>)}
            </dl>
            <a class="button button--amber vol-card__action" href={role.url} target="_blank" rel="noopener noreferrer">Sign up for {role.name.toLowerCase()} <span class="external-link-icon" aria-hidden="true">↗</span><span class="visually-hidden"> (opens Volunteer Sign Up in a new tab)</span></a>
          </li>
        ))}
      </ul>
      <p class="vol-back"><a class="button button--secondary" href={withBase(event.path!)}>View Fireworks event details <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>
</BaseLayout>

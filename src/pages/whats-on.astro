---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import EventRow from "../components/EventRow.astro";
import EventVisibilityInit from "../components/EventVisibilityInit.astro";
import { isHidden, ukDateKey } from "../lib/event-visibility";
import { eventVisibilityRules } from "../lib/event-lifecycle";
import { academicMonths, academicYearStart, academicYearLabel } from "../lib/academic-year";

const events = (await getCollection("events")).map(({ data }) => data);
const months = academicMonths(events);
// Older records stay in the collection, but only this academic year is listed.
// Never silently lose dates published for the next year.
const nextYear = `${academicYearStart + 1}-09`;
if (events.some((event) => ukDateKey(event.start).slice(0, 7) >= nextYear)) {
  throw new Error("Future events fall beyond the configured academic year. Review academicYearStart before publishing.");
}
const now = Date.now();
const currentMonth = ukDateKey(new Date(now)).slice(0, 7);
const upcoming = (event: (typeof events)[number]) => !isHidden(eventVisibilityRules(event), now);
const past = (event: (typeof events)[number]) => !isHidden(eventVisibilityRules(event, true), now);
const monthVisible = (month: (typeof months)[number]) => month.events.some(upcoming);
const terms = [
  { name: "Autumn term", note: `September to December ${academicYearStart}`, months: months.slice(0, 4) },
  { name: "Spring term", note: `January to March ${academicYearStart + 1}`, months: months.slice(4, 7) },
  { name: "Summer term", note: `April to August ${academicYearStart + 1}`, months: months.slice(7) },
];
const year = academicYearLabel();
---
<BaseLayout title="What's On" description={`Events listed by The Friends of Ashley for ${year}, grouped term by term with earlier events to look back on.`}>
  <PageHero eyebrow="Dates for the diary" title="What's on at Ashley" intro="The academic year, term by term." />
  <section class="content-section content-section--compact" data-yearview-empty hidden={months.some((month) => month.events.some(upcoming))}>
    <div class="site-width"><p>No upcoming events are listed for {year}. We’ll share more dates when they are confirmed.</p></div>
  </section>
  {terms.map((term, index) => (
    <section class:list={["content-section", "content-section--compact", index === 1 && "tinted-section"]} data-yearview-term hidden={!term.months.some(monthVisible)}>
      <div class="site-width">
        <div class="section-heading"><p class="eyebrow">{term.note}</p><h2>{term.name}</h2></div>
        <div class="term-months">
          {term.months.map((month) => (
            <div class="term-month" data-month-key={month.key} hidden={!monthVisible(month)}>
              <h3 class="term-month-heading">{month.label}<span class="term-chip" data-current-chip hidden={month.key !== currentMonth}>This month</span></h3>
              <div class="event-list" hidden={!month.events.some(upcoming)}>{month.events.map((event) => <EventRow event={event} now={now} headingLevel="h4" />)}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}
  <section class="content-section content-section--compact tinted-section" data-past-events-section hidden={!months.some((month) => month.events.some(past))}>
    <div class="site-width">
      <details class="term-earlier">
        <summary><h2>Earlier this year</h2></summary>
        <div class="term-months" data-yearview-earlier>
          {months.toReversed().filter((month) => month.events.length).map((month) => (
            <div class="term-month" data-earlier-month={month.key} hidden={!month.events.some(past)}>
              <h3 class="term-month-heading">{month.label}</h3>
              <div class="event-list">{month.events.toReversed().map((event) => <EventRow event={event} past now={now} headingLevel="h4" />)}</div>
            </div>
          ))}
        </div>
      </details>
    </div>
  </section>
  <EventVisibilityInit />
</BaseLayout>

<script>
  import { syncEventVisibility, syncRelativeDates } from "../lib/event-visibility";
  import { syncYearView } from "../lib/academic-year";
  const update = () => {
    const now = Date.now();
    syncEventVisibility(now);
    syncYearView(now);
    syncRelativeDates(now);
  };
  update();
  window.setInterval(update, 60000);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) update(); });
</script>

<style>
  .section-heading .eyebrow { margin: 0 0 var(--whats-on-term-date-gap); line-height: 1; }
  .section-heading h2 { line-height: 1; }
  .term-month :global(.event-list-item) {
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--whats-on-event-date-gap);
    align-items: start;
  }
  @container (max-width: 14rem) {
    .term-month :global(.event-list-item) { grid-template-columns: minmax(0, 1fr); }
  }
  .term-months { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  .term-month-heading {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 500;
    color: var(--heading);
    margin: 0 0 0.75rem;
    padding: 0.625rem 0.75rem;
    background: var(--paper-deep);
    border-bottom: 1px solid var(--line);
    overflow-wrap: anywhere;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
  }
  .term-month > .event-list { border-top: 0; }
  .term-chip {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber-dark);
  }
  :root[data-theme="night"] .term-chip { color: var(--night-amber-ink); }
  .term-earlier summary { cursor: pointer; min-height: 44px; }
  .term-earlier summary h2 { display: inline; }
  .term-earlier[open] summary { margin-bottom: 1.5rem; }
</style>

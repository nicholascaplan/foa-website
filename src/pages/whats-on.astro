---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import EventList from "../components/EventList.astro";
import { withBase } from "../lib/urls";
import { ordinalDateFormatter } from "../lib/dates";
const formatDate = ordinalDateFormatter({ weekday: "long", timeZone: "Europe/London" });
const events = await getCollection("events");
const upcoming = events.filter(({ data }) => !data.archive).sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());
const past = events.filter(({ data }) => data.archive || data.archiveFrom).sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
const hasPermanentPastEvents = past.some(({ data }) => data.archive && !data.archiveFrom);
---
<BaseLayout title="What's On" description="Upcoming events from The Friends of Ashley and selected events from earlier this year.">
  <PageHero eyebrow="Dates for the diary" title="What's on at Ashley" intro="A chronological view of the next things families need to know." />
  <section class="content-section content-section--compact"><div class="site-width"><div class="section-heading"><p class="eyebrow">Coming up</p><h2>Upcoming events</h2></div><EventList events={upcoming} showBeforeArchive /></div></section>
  <section class="content-section tinted-section content-section--compact" data-past-events-section hidden={!hasPermanentPastEvents}><div class="site-width"><div class="section-heading"><p class="eyebrow">Earlier this year</p><h2>Past events</h2></div>{past.map(({ data }) => <article class="past-event" data-show-from={data.archiveFrom?.toISOString()} hidden={Boolean(data.archiveFrom)}><img src={withBase(`/${encodeURIComponent(data.image ?? "")}`)} alt={data.imageAlt} width="714" height="1000"><div><p class="eyebrow"><time datetime={data.start.toISOString()}>{formatDate(data.start)}</time></p><h3>{data.title}</h3><p>{data.pastSummary ?? data.summary}</p></div></article>)}</div></section>
</BaseLayout>

<script>
  import { syncEventVisibility } from "../lib/event-visibility";

  const updateEventSections = () => {
    syncEventVisibility();
    const pastSection = document.querySelector<HTMLElement>("[data-past-events-section]");
    if (pastSection) pastSection.hidden = !pastSection.querySelector(".past-event:not([hidden])");
  };

  updateEventSections();
  window.setInterval(updateEventSections, 60000);
</script>

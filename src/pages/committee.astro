---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
const members = (await getCollection("committee")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Committee" description="Meet the Friends of Ashley committee for 2026/27.">
  <PageHero eyebrow="The FOA team" title="Meet the committee." intro="The 2026/27 names and roles are confirmed. Higher-resolution portraits and final publication consent are still required before launch." />
  <section class="content-section content-section--compact"><div class="site-width"><div class="committee-grid">{members.map(({ data }) => <article class:list={["member-card", data.imageClass]}><div class="member-photo"><img src={`/${data.portrait}`} alt={data.name} loading="lazy"></div><div class="member-details"><h2>{data.name}</h2><p>{data.role}</p></div></article>)}</div><div class="committee-note"><div><h2>There is room for you too.</h2><p>FOA welcomes help from parents, carers and staff. The Co-Secretary role is currently vacant.</p></div><a class="button button--amber" href="mailto:thefriendsofashley@gmail.com?subject=FOA%20Co-Secretary%20role">Ask about the role</a></div></div></section>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/urls";
const members = (await getCollection("committee")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Committee" description="Meet the committee of The Friends of Ashley for 2026/27.">
  <PageHero eyebrow="The FOA team" title="Meet the committee." intro="Meet the 2026/27 committee and find out how to get involved." />
  <section class="content-section content-section--compact"><div class="site-width"><div class="committee-grid">{members.map(({ data }) => <article class:list={["member-card", data.imageClass]}><div class="member-photo"><img src={withBase(`/${data.portrait}`)} alt={data.name} loading="lazy"></div><div class="member-details"><h2>{data.name}</h2><p>{data.role}</p></div></article>)}<article class="member-card member-card--vacancy"><div class="member-vacancy"><p class="member-vacancy-label">A seat is waiting</p><div class="member-vacancy-name"><span>Join</span><strong>the team</strong></div><p class="member-vacancy-copy">Bring your ideas, share the role and help keep The FOA organised.</p><a href="mailto:thefriendsofashley@gmail.com?subject=The%20FOA%20Co-Secretary%20role&amp;body=Hello%20The%20FOA%20team%2C%0A%0AI%20would%20like%20to%20ask%20about%20the%20Co-Secretary%20role.%0A%0AThanks%2C">Ask us about the role <span aria-hidden="true">&rarr;</span></a></div><div class="member-details"><h2>Vacancy</h2><p>Co-Secretary</p></div></article></div><div class="committee-note"><div><h2>There is room for you too.</h2><p>The FOA welcomes help from parents, carers and staff. The Co-Secretary role is currently vacant.</p></div><a class="button button--amber" href="mailto:thefriendsofashley@gmail.com?subject=The%20FOA%20Co-Secretary%20role&amp;body=Hello%20The%20FOA%20team%2C%0A%0AI%20would%20like%20to%20ask%20about%20the%20Co-Secretary%20role.%0A%0AThanks%2C">Ask about the role</a></div></div></section>
</BaseLayout>

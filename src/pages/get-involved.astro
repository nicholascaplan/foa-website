---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/urls";
---
<BaseLayout title="Get Involved" description="Ways to volunteer, attend meetings and support The Friends of Ashley.">
  <PageHero eyebrow="Everyone is welcome" title="Small help makes a real difference." intro="Meetings are informal and open to parents, carers and staff." />
  <section class="content-section content-section--compact"><div class="site-width"><article class="vacancy-card"><div class="vacancy-copy"><p class="eyebrow">Role vacancy</p><h2>Could you be our next <span class="co-secretary">Co-Secretary?</span></h2><p>A light, termly role that one person can do or two can share: agendas, minutes and keeping our paperwork in order. Sarah Parish and Katy Furber, the outgoing Secretaries, are happy to have a quick chat first.</p></div><div class="vacancy-actions"><a class="button button--dark" href="mailto:thefriendsofashley@gmail.com?subject=The%20FOA%20Co-Secretary%20role&amp;body=Hello%20The%20FOA%20team%2C%0A%0AI%20would%20like%20to%20ask%20about%20the%20Co-Secretary%20role.%0A%0AThanks%2C">Ask about the role</a><a class="button button--secondary" href={withBase("/committee/")}>Meet the committee</a></div></article></div></section>
  <section class="content-section tinted-section content-section--compact"><div class="site-width"><p class="eyebrow">Events</p><h2 class="editorial-heading">Could you help lead an event?</h2><p class="section-copy">Rachel and Sophie are leading this year's Christmas Fayre. The FOA is also looking for someone to shadow Helen at Fireworks 2026 and learn how to lead the event in 2027, with no pressure.</p><div class="vacancy-actions"><a class="button button--primary" href="mailto:thefriendsofashley@gmail.com?subject=Shadowing%20Helen%20at%20Fireworks%202026&amp;body=Hello%20The%20FOA%20team%2C%0A%0AI%20would%20like%20to%20ask%20about%20shadowing%20Helen%20at%20Fireworks%202026.%0A%0AThanks%2C">Offer to shadow Helen</a><a class="button button--secondary" href={withBase("/whats-on/")}>See what's on</a></div></div></section>
  <section class="content-section content-section--compact"><div class="site-width"><p class="eyebrow">Other ways to join in</p><h2 class="editorial-heading">Not ready to lead? Start here.</h2><div class="link-grid"><a class="info-card info-card--link" href={withBase("/meeting-minutes/")}><h3>Come to a meeting</h3><p>Meetings are informal and open to everyone. Catch up on past minutes first.</p></a><a class="info-card info-card--link" href={withBase("/reps/")}><h3>Be a class rep</h3><p>Share messages from The FOA with your class group.</p></a><a class="info-card info-card--link" href={withBase("/about/")}><h3>Find out more</h3><p>See what The FOA does and where the money goes.</p></a></div></div></section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/urls";
const messages = [
  { month: "NOV", day: "05", title: "Fireworks on the Field", body: "FOA Fireworks is on Thursday 5th November, 16:30-18:30, with the quiet display at 17:00 and main display at 18:00. Tickets are £8.50 per person; under-2s are free. The booking link will follow.", href: "/events/fireworks-2026/" },
  { month: "NOV", day: "06", title: "Pre-loved uniform", body: "The next sales are Friday 6th November and Friday 4th December at 15:25 in the school playground. New-logo items and coats are £3; all other items are £1. Card only.", href: "/uniform/" },
  { month: "DEC", day: "05", title: "Christmas Fayre", body: "Save the date: Saturday 5th December. Rachel and Sophie are leading this year's Fayre and will share class stalls, donations and volunteer details soon.", href: "/whats-on/" },
];
---
<BaseLayout title="Reps Hub" description="Friends of Ashley messages for class representatives to share.">
  <PageHero eyebrow="For class representatives" title="Reps Hub" intro="Useful FOA updates to share with class groups." />
  <section class="content-section content-section--compact"><div class="site-width"><div class="message-grid">{messages.map((message) => <article class="message-card"><div class="message-date" aria-label={`${message.month} ${message.day}`}><span>{message.month}</span><strong>{message.day}</strong></div><h2>{message.title}</h2><p>{message.body}</p><div class="message-actions"><button class="button button--secondary" type="button" data-copy-button data-copy-text={message.body}>Copy message</button><a class="text-link" href={withBase(message.href)}>Learn more <span aria-hidden="true">&rarr;</span></a></div><p class="copy-feedback" data-copy-feedback role="status" aria-live="polite"></p></article>)}</div></div></section>
</BaseLayout>

<script>
  const copyText = async (text: string) => {
    if (!navigator.clipboard?.writeText) throw new Error("Copy was not available");
    await navigator.clipboard.writeText(text);
  };

  document.querySelectorAll<HTMLButtonElement>("[data-copy-button]").forEach((button) => {
    button.addEventListener("click", async () => {
      const feedback = button.closest<HTMLElement>(".message-card")?.querySelector<HTMLElement>("[data-copy-feedback]");
      const text = button.dataset.copyText;
      if (!feedback || !text) return;

      try {
        await copyText(text);
        feedback.textContent = "Copied to clipboard.";
        window.setTimeout(() => {
          feedback.textContent = "";
        }, 3000);
      } catch {
        feedback.textContent = "Copy was not available. Select the message above to copy it manually.";
      }
    });
  });
</script>

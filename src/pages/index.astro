---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
import { ordinalDateFormatter } from "../lib/dates";
const events = await getCollection("events");
const fireworks = events.find(({ id }) => id === "fireworks-2026")?.data;
const welcomeTea = events.find(({ id }) => id === "welcome-tea-2026")?.data;
if (!fireworks || !welcomeTea) throw new Error("Homepage event content is missing");
const latestNewsletter = (await getCollection("newsletters"))
  .filter(({ data }) => data.published)
  .sort((a, b) => b.data.published!.getTime() - a.data.published!.getTime())[0]?.data;
const newsletterSent = latestNewsletter?.published ? ordinalDateFormatter({ timeZone: "UTC" })(latestNewsletter.published) : undefined;
const fireworksDate = ordinalDateFormatter({ weekday: "long", timeZone: "Europe/London" })(fireworks.start);
const timeFormatter = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Europe/London" });
const fireworksTimes = fireworks.end ? `${timeFormatter.format(fireworks.start)}-${timeFormatter.format(fireworks.end)}` : timeFormatter.format(fireworks.start);
---
  <BaseLayout title="The Friends of Ashley" description="The Friends of Ashley, the PTA for Ashley C of E Primary School in Walton-on-Thames." preloadImage="/welcome%20tea.png">
  <div class="notice-strip"><div class="site-width"><span class="notice-dot" aria-hidden="true"></span><span>Could you be our Co-Secretary for 2026/27?</span><a href={withBase("/get-involved/")}>See the role</a></div></div>
  <section class="hero">
    <div class="site-width hero-grid">
       <div class="hero-copy"><p class="eyebrow">Parent-led. Child-focused. All welcome.</p><h1>Helping Ashley children <em>flourish.</em></h1><p>The Friends of Ashley brings parents, carers and staff together to create memorable events, fund extra opportunities and strengthen our school community.</p><div class="hero-actions"><a class="button button--primary" href={withBase("/whats-on/")}>See what's coming up <span aria-hidden="true">&rarr;</span></a><a class="button button--secondary" href={withBase("/get-involved/")}>Find a way to help</a></div></div>
        <article class="event-feature event-feature--poster" data-show-before={welcomeTea.archiveFrom?.toISOString()}><p class="eyebrow">Upcoming event</p><h2>{welcomeTea.title}</h2><a class="event-poster-link" href={withBase("/whats-on/")}><img src={withBase(`/${encodeURIComponent(welcomeTea.image!)}`)} alt={welcomeTea.imageAlt} width="863" height="1260"></a></article>
        <article class="event-feature event-feature--poster" data-show-from={welcomeTea.archiveFrom?.toISOString()} hidden><p class="eyebrow">Next major event</p><h2>{fireworks.title}</h2><a class="event-poster-link event-poster-link--wide" href={withBase(fireworks.path!)}><img src={withBase("/fireworks-1600.jpg")} alt="Fireworks lighting up the sky over the school field." width="1600" height="1066"></a><p class="event-feature-when"><time datetime={fireworks.start.toISOString()}>{fireworksDate}</time> · {fireworksTimes}</p><a class="button button--primary" href={withBase(fireworks.path!)}>Find out more <span aria-hidden="true">&rarr;</span></a></article>
    </div>
  </section>
  <section class="quick-actions"><div class="site-width"><div class="quick-list">
     {latestNewsletter && <a class="quick-row" href={withBase("/newsletter/")}><span><h3>Read the latest newsletter</h3><p>{latestNewsletter.title}, sent {newsletterSent}.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>}
     <a class="quick-row" href={withBase("/events/fireworks-2026/")}><span><h3>Plan for Fireworks</h3><p>Times, tickets and what to expect on the night.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>
     <a class="quick-row" href={withBase("/uniform/")}><span><h3>Buy or donate uniform</h3><p>Sale dates, donation point and price list.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>
     <a class="quick-row" href={withBase("/get-involved/")}><span><h3>Get involved</h3><p>Roles, meetings, class reps and ways to help.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>
  </div></div></section>
</BaseLayout>

<script>
  import { syncEventVisibility } from "../lib/event-visibility";

  syncEventVisibility();
  window.setInterval(syncEventVisibility, 60000);
</script>

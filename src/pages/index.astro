---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SponsorRibbon from "../components/SponsorRibbon.astro";
import FundraisingSummary from "../components/FundraisingSummary.astro";
import { withBase } from "../lib/urls";
import { ordinalDateFormatter } from "../lib/dates";
const events = await getCollection("events");
const fireworks = events.find(({ id }) => id === "fireworks-2026")?.data;
if (!fireworks) throw new Error("Homepage event content is missing");
const latestNewsletter = (await getCollection("newsletters"))
  .filter(({ data }) => data.published)
  .sort((a, b) => b.data.published!.getTime() - a.data.published!.getTime())[0]?.data;
const appeal = (await getCollection("fundraising")).find(({ id }) => id === "current-appeal")?.data;
if (!appeal) throw new Error("Homepage fundraising content is missing");
const fireworksDate = ordinalDateFormatter({ weekday: "long", timeZone: "Europe/London" })(fireworks.start);
const timeFormatter = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Europe/London" });
const fireworksSchedule = fireworks.schedule ?? [];
const scheduleStart = fireworksSchedule[0]?.time.getTime() ?? 0;
const scheduleSpan = (fireworksSchedule.at(-1)?.time.getTime() ?? 0) - scheduleStart;
const scheduleFraction = (time: Date) => (scheduleSpan > 0 ? (time.getTime() - scheduleStart) / scheduleSpan : 0.5);
const datePart = (options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", ...options }).format(fireworks.start);
const fireworksWeekday = datePart({ weekday: "short" });
const fireworksDay = datePart({ day: "numeric" });
const fireworksMonth = datePart({ month: "short" });
---
  <BaseLayout title="The Friends of Ashley" description="The Friends of Ashley, the PTA for Ashley C of E Primary School in Walton-on-Thames." preloadImage="/events/fireworks-1600.jpg" bodyClass="homepage">
  <section class="hero">
    <div class="site-width hero-grid">
       <div class="hero-copy">
         <div class="home-introduction">
           <img src={withBase("/brand/foa-logo.jpg")} alt="The Friends of Ashley logo" width="160" height="160">
           <p><strong>The Friends of Ashley</strong><span>Ashley C of E Primary School PTA</span></p>
         </div>
         <p class="eyebrow">Parent-led. Child-focused. All welcome.</p><h1>Helping Ashley children <em>flourish.</em></h1><p>The Friends of Ashley brings parents, carers and staff together to create memorable events, fund extra opportunities and strengthen our school community.</p><div class="hero-actions">{fireworks.ticketUrl && <a class="button button--amber button--large" href={fireworks.ticketUrl} target="_blank" rel="noopener noreferrer">Buy Fireworks tickets <span class="external-link-icon" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>}<a class="button button--primary button--large button--wide" href={withBase("/fireworks-volunteering/")}>Volunteer at Fireworks <span aria-hidden="true">&rarr;</span></a></div>
       </div>
        <article class="event-feature event-feature--poster">
          <p class="event-feature-kicker">Remember Remember the 5th of November</p><h2>{fireworks.title}</h2>
          <a class="event-poster-link event-poster-link--wide event-poster-link--sponsored" href={withBase(fireworks.path!)}>
            <img src={withBase("/events/fireworks-1600.jpg")} alt="Fireworks lighting up the sky over the school field." width="1600" height="1066">
            <SponsorRibbon />
          </a>
          <div class="event-feature-when"><time class="date-tile" datetime={fireworks.start.toISOString()}><span class="visually-hidden">{fireworksDate}</span><span aria-hidden="true" class="date-tile__weekday">{fireworksWeekday}</span><strong aria-hidden="true" class="date-tile__day">{fireworksDay}</strong><span aria-hidden="true" class="date-tile__month">{fireworksMonth}</span></time><p class="event-feature-where"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>{fireworks.location}</p></div><ol class="event-timeline">{fireworksSchedule.map((item) => <li style={`--at: ${scheduleFraction(item.time)}`}><time datetime={item.time.toISOString()}>{timeFormatter.format(item.time)}</time><span>{item.label}</span></li>)}</ol><div class="event-feature-actions"><a class="button button--primary" href={withBase(fireworks.path!)}>Event details <span aria-hidden="true">&rarr;</span></a></div>
        </article>
     <div class="quick-list hero-links">
     {latestNewsletter && <a class="quick-row" href={withBase("/newsletter/")}><span><h3>Read the latest newsletter</h3><p>{latestNewsletter.title}</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>}
     <a class="quick-row" href={withBase("/get-involved/")}><span><h3>Get involved</h3><p>Roles, meetings, class reps and ways to help.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>
     </div>
    </div>
  </section>
  <section class="fundraising-update" aria-labelledby="fundraising-update-title">
    <div class="site-width">
      <FundraisingSummary appeal={appeal} />
    </div>
  </section>
</BaseLayout>

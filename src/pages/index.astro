---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SponsorRibbon from "../components/SponsorRibbon.astro";
import FundraisingSummary from "../components/FundraisingSummary.astro";
import MobilePageHeading from "../components/MobilePageHeading.astro";
import { withBase } from "../lib/urls";
import { ordinalDateFormatter } from "../lib/dates";
const events = await getCollection("events");
const fireworks = events.find(({ id }) => id === "fireworks-2026")?.data;
if (!fireworks) throw new Error("Homepage event content is missing");
const latestNewsletter = (await getCollection("newsletters"))
  .filter(({ data }) => data.published)
  .sort((a, b) => b.data.published!.getTime() - a.data.published!.getTime())[0]?.data;
const appeal = (await getCollection("fundraising")).find(({ id }) => id === "current-appeal")?.data;
if (!appeal) throw new Error("Homepage fundraising content is missing");
const fireworksDate = ordinalDateFormatter({ weekday: "long", timeZone: "Europe/London" })(fireworks.start);
const timeFormatter = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Europe/London" });
const fireworksSchedule = fireworks.schedule ?? [];
const scheduleStart = fireworksSchedule[0]?.time.getTime() ?? 0;
const scheduleSpan = (fireworksSchedule.at(-1)?.time.getTime() ?? 0) - scheduleStart;
const scheduleFraction = (time: Date) => (scheduleSpan > 0 ? (time.getTime() - scheduleStart) / scheduleSpan : 0.5);
const datePart = (options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", ...options }).format(fireworks.start);
const fireworksWeekday = datePart({ weekday: "short" });
const fireworksDay = datePart({ day: "numeric" });
const fireworksMonth = datePart({ month: "short" });
const fireworksSrcset = [640, 960, 1600].map((width) => `${withBase(`/events/fireworks-${width}.webp`)} ${width}w`).join(", ");
// Conservative rendered-width estimates, shared by the image and its preload.
const fireworksSizes = "(min-width: 80rem) 30rem, (min-width: 48rem) 40vw, calc(100vw - 5rem)";
---
   <BaseLayout title="The Friends of Ashley" description="The Friends of Ashley, the PTA for Ashley C of E Primary School in Walton-on-Thames." preloadImage="/events/fireworks-960.webp" preloadImageSrcset={fireworksSrcset} preloadImageSizes={fireworksSizes} bodyClass="homepage">
  <section class="hero">
    <div class="site-width hero-grid">
      <div class="hero-event">
       <div class="hero-copy">
          <MobilePageHeading>
            <h1 data-fit-heading>Fireworks on the <em>Field.</em></h1>
          </MobilePageHeading>
          <p><strong>{fireworksDate}, {fireworks.location}.</strong> Gates open {timeFormatter.format(fireworks.start)}, event closes {timeFormatter.format(fireworks.end)}.</p><div class="hero-actions">{fireworks.ticketUrl && <a class="button button--amber button--large" href={fireworks.ticketUrl} target="_blank" rel="noopener noreferrer"><span class="cta-label">Buy Fireworks <span class="cta-word">ticket<span class="cta-tail">s<span class="external-link-icon cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></span></a>}<a class="button button--primary button--large button--wide" href={withBase("/fireworks-volunteering/")}><span class="cta-label">Volunteer at <span class="cta-word">Firework<span class="cta-tail">s<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a></div>
       </div>
        <article class="event-feature event-feature--poster">
          <p class="event-feature-kicker">Remember Remember the 5th of November</p>
          <a class="event-poster-link event-poster-link--wide event-poster-link--sponsored" href={withBase(fireworks.path!)}>
            <img src={withBase("/events/fireworks-960.webp")} srcset={fireworksSrcset} sizes={fireworksSizes} alt="Fireworks lighting up the sky over the school field." width="1600" height="1066" fetchpriority="high" decoding="async">
            <SponsorRibbon />
          </a>
          <div class="event-feature-when"><time class="date-tile" datetime={fireworks.start.toISOString()}><span class="visually-hidden">{fireworksDate}</span><span aria-hidden="true" class="date-tile__weekday">{fireworksWeekday}</span><strong aria-hidden="true" class="date-tile__day">{fireworksDay}</strong><span aria-hidden="true" class="date-tile__month">{fireworksMonth}</span></time><p class="event-feature-where"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>{fireworks.location}</p></div><ol class="event-timeline">{fireworksSchedule.map((item) => <li style={`--at: ${scheduleFraction(item.time)}`}><time datetime={item.time.toISOString()}>{timeFormatter.format(item.time)}</time><span>{item.label}</span></li>)}</ol><div class="event-feature-actions"><a class="button button--primary" href={withBase(fireworks.path!)}><span class="cta-label">Event <span class="cta-tail">details<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></a></div>
        </article>
      </div>
     <div class="quick-list hero-links">
     {latestNewsletter && <a class="quick-row" href={withBase("/newsletter/")}><span><h3>Read the latest newsletter</h3><p>{latestNewsletter.title}</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>}
     <a class="quick-row" href={withBase("/get-involved/")}><span><h3>Get involved</h3><p>Roles, meetings, class reps and ways to help.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>
     </div>
    </div>
  </section>
  <section class="site-width home-intro">
    <h2>Helping Ashley children <em>flourish.</em></h2>
    <p>The Friends of Ashley brings parents, carers and staff together to create memorable events, fund extra opportunities and strengthen our school community.</p>
  </section>
  <section class="fundraising-update" aria-labelledby="fundraising-update-title">
    <div class="site-width">
      <FundraisingSummary appeal={appeal} />
    </div>
  </section>
</BaseLayout>

<script>
  import { initHeadingFit } from "../lib/heading-fit";
  initHeadingFit();
</script>
